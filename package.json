{
  "name": "villafortech-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "validate:locales": "node scripts/validate-locales.mjs",
    "validate:site": "node scripts/validate-site.mjs",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "verify:resume": "node scripts/verify-resume-print.mjs",
    "verify": "npm run check && npm run format:check && npm run build && npm run validate:html && npm run validate:locales && npm run validate:site",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.9",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.0.0",
    "html-validate": "^11.10.0",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.9.3"
  }
}
