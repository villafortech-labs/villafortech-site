{
  "extends": "astro/tsconfigs/strict",
  "exclude": ["output", "tmp", "dist", "node_modules"],
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@data/*": ["src/data/*"]
    }
  }
}
