---
import ArrowIcon from '../../components/ArrowIcon.astro';
import PanoramaPreview from '../../components/PanoramaPreview.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localeRoutes, type Locale } from '../../i18n';
import '../../styles/projects-renewal.css';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const es = locale === 'es';
const routes = localeRoutes[locale];
const copy = {
  title: es ? 'Proyectos' : 'Projects',
  description: es
    ? 'Los proyectos de Roberto Villafuerte: Panorama, sistemas de IA, arquitectura de datos y aprendizaje automático. El problema, las decisiones y la evidencia.'
    : 'Projects by Roberto Villafuerte: Panorama, AI systems, data architecture, and machine learning. The problem, the decisions, and the evidence.',
  heading: es ? 'Lo que aprendo, construyendo.' : 'What I learn by building.',
  deck: es
    ? 'Un producto propio, experimentos y trabajo en equipo. Cada caso cuenta qué construí, por qué tomé ciertas decisiones y qué queda por comprobar.'
    : 'An independent product, experiments, and work with others. Each case explains what I built, why I made those decisions, and what still needs testing.',
  panorama: es
    ? 'Panorama, de una idea al producto.'
    : 'Panorama, from idea to product.',
  panoramaDeck: es
    ? 'Estoy construyendo una aplicación para organizar gastos, ingresos y planes. La IA ayuda a interpretar lo que registras; tú revisas la propuesta antes de guardarla.'
    : 'I’m building an application for organizing expenses, income, and plans. AI helps interpret what you enter; you review the proposal before saving it.',
  panoramaNote: es
    ? 'Producto web público. Implementación privada.'
    : 'Public web product. Private implementation.',
  more: es ? 'Trabajo que puedo mostrar.' : 'Work I can share.',
  moreDeck: es
    ? 'Código abierto cuando está disponible; notas delimitadas cuando el trabajo es privado.'
    : 'Open source where available; carefully scoped notes where the work is private.',
  read: es ? 'Leer el caso' : 'Read the case',
  visit: es ? 'Abrir Panorama' : 'Open Panorama',
  topics: es ? 'Tecnologías y temas' : 'Technologies and topics',
  public: es ? 'Código y evidencia públicos' : 'Public source and evidence',
  sanitized: es ? 'Nota de un trabajo privado' : 'Note on private work',
  private: es ? 'Trabajo privado' : 'Private work',
};
const projects = (
  await getCollection(
    'projects',
    ({ data }) => data.evidence !== 'hold' && data.locale === locale,
  )
).sort(
  (a, b) =>
    (a.data.featuredOrder ?? 99) - (b.data.featuredOrder ?? 99) ||
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const panorama = projects.find(
  (project) => project.data.translationKey === 'panorama',
);
const otherProjects = projects.filter(
  (project) => project.data.translationKey !== 'panorama',
);
const href = (project: (typeof projects)[number]) =>
  `${routes.projects}${project.data.translationKey ?? project.data.slug}/`;
const evidenceLabel = (evidence?: string) =>
  evidence === 'public'
    ? copy.public
    : evidence === 'sanitized'
      ? copy.sanitized
      : copy.private;
---

<BaseLayout title={copy.title} description={copy.description} locale={locale}>
  <header class="project-opening shell">
    <h1>{copy.heading}</h1>
    <p>{copy.deck}</p>
  </header>

  {
    panorama && (
      <section class="project-product" aria-labelledby="panorama-heading">
        <div class="shell project-product__layout">
          <div class="project-product__copy">
            <h2 id="panorama-heading">{copy.panorama}</h2>
            <p>{copy.panoramaDeck}</p>
            <p class="project-product__note">{copy.panoramaNote}</p>
            <div class="project-product__actions">
              <a class="plain-link" href={href(panorama)}>
                {copy.read}
                <ArrowIcon direction="right" />
              </a>
              <a class="plain-link" href={panorama.data.links?.demo}>
                {copy.visit}
                <ArrowIcon />
              </a>
            </div>
          </div>
          <PanoramaPreview locale={locale} compact />
        </div>
      </section>
    )
  }

  <section
    class="project-archive shell"
    aria-labelledby="project-archive-heading"
  >
    <div class="project-archive__heading">
      <h2 id="project-archive-heading">{copy.more}</h2>
      <p>{copy.moreDeck}</p>
    </div>
    <div class="project-archive__list">
      {
        otherProjects.map((project) => (
          <article class="project-entry">
            <div class="project-entry__title">
              <p>{project.data.organization || project.data.role}</p>
              <h3>
                <a href={href(project)}>
                  {project.data.shortTitle || project.data.title}
                </a>
              </h3>
              <p>
                {project.data.projectPeriod || project.data.date.slice(0, 4)}
              </p>
            </div>
            <div class="project-entry__body">
              <p>{project.data.summary}</p>
              <p class="project-entry__evidence">
                {evidenceLabel(project.data.evidence)}
              </p>
              <ul aria-label={copy.topics}>
                {project.data.tags.slice(0, 4).map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <a class="plain-link" href={href(project)}>
                {copy.read}
                <ArrowIcon direction="right" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
