---
import '../../styles/global.css';
const title = 'Revisión de aplicaciones · Villa for Tech';
const description =
  'Acceso privado para revisar las aplicaciones a las cinco sesiones de segundo cerebro.';
const canonical = new URL('/segundo-cerebro/revision/', Astro.site);
const image = new URL('/og-segundo-cerebro.png', Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#f3eee3" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <header class="review-header">
      <img
        src="/brand/signature-horizontal.svg"
        alt="Villa for Tech"
        width="220"
        height="60"
      />
      <span>Área privada · Octubre 2026</span>
    </header>
    <main id="main-content" class="review-shell" tabindex="-1">
      <div class="intro">
        <p class="eyebrow">Tu segundo cerebro</p>
        <h1>Cinco personas.<br /><em>Cinco formas de trabajar.</em></h1>
        <p>
          Revisa las aplicaciones, toma notas y elige los casos que trabajarás
          el 15 y 16 de octubre.
        </p>
      </div>
      <p id="feedback" class="notice" role="status" aria-live="polite" hidden>
      </p>
      <section
        id="access-panel"
        class="access-panel"
        aria-labelledby="access-title"
      >
        <h2 id="access-title">Acceso a las respuestas</h2>
        <p>
          Las respuestas se cargan después de iniciar sesión. Usa la clave
          privada de revisión.
        </p>
        <form
          id="login-form"
          autocomplete="on"
          method="post"
          action="/api/pilot-admin"
        >
          <label for="review-secret">Clave de revisión</label>
          <input
            id="review-secret"
            name="password"
            type="password"
            autocomplete="current-password"
            required
          />
          <button type="submit">Entrar a la revisión</button>
        </form>
      </section>
      <section id="workspace" aria-label="Aplicaciones recibidas" hidden>
        <div class="overview">
          <div>
            <p class="eyebrow">Tu selección</p><p class="selection-count">
              <span id="selected-count">0</span><span> / 5 personas</span>
            </p>
          </div>
          <p>
            Seleccionar aquí guarda tu decisión. <strong
              >No envía mensajes a las personas ni confirma su horario.</strong
            > El presupuesto no determina la selección.
          </p>
          <div class="toolbar">
            <button id="refresh" type="button" class="secondary"
              >Actualizar</button
            ><button id="logout" type="button" class="secondary"
              >Cerrar sesión</button
            >
          </div>
        </div>
        <p id="notification-status" class="notice"></p>
        <div class="filters">
          <div class="field">
            <label for="search">Buscar en las respuestas cargadas</label><input
              id="search"
              type="search"
              placeholder="Nombre, correo, proyecto, herramienta…"
              autocomplete="off"
            />
          </div>
          <div class="field">
            <label for="status-filter">Estado</label><select id="status-filter"
              ><option value="all">Todos los estados</option><option
                value="pending">Pendiente</option
              ><option value="shortlist">Preselección</option><option
                value="selected">Seleccionada</option
              ><option value="waitlist">Lista de espera</option><option
                value="not_selected">No seleccionada</option
              ></select
            >
          </div>
          <label class="check"
            ><input id="show-tests" type="checkbox" /> Ver aplicaciones de prueba</label
          >
        </div>
        <div class="results-toolbar">
          <p id="results-count" aria-live="polite"></p><button
            id="export"
            type="button"
            class="secondary">Descargar CSV de esta vista</button
          >
        </div>
        <p class="small">
          Horarios en Ecuador (UTC−5). Las notas son privadas. El CSV contiene
          datos de contacto; guárdalo en un lugar privado.
        </p>
        <div class="table-wrap">
          <table>
            <caption class="sr-only"
              >Aplicaciones al segundo cerebro: datos, preferencias y revisión</caption
            >
            <thead
              ><tr
                ><th scope="col">Persona</th><th scope="col">Área y objetivo</th
                ><th scope="col">Herramientas</th><th scope="col"
                  >Presupuesto mensual</th
                ><th scope="col">Disponibilidad</th><th scope="col">Revisión</th
                ></tr
              ></thead
            >
            <tbody id="applications"></tbody>
          </table>
        </div>
        <p id="empty-state" class="empty" hidden></p>
        <button id="load-more" type="button" class="secondary" hidden
          >Cargar más aplicaciones</button
        >
      </section>
      <noscript
        ><p class="notice">
          Activa JavaScript para iniciar sesión y revisar las aplicaciones de
          forma privada.
        </p></noscript
      >
    </main>
    <footer class="review-footer">
      Villa for Tech · Revisión privada de las cinco sesiones gratuitas
    </footer>
  </body>
</html>

<script>
  import {
    roles,
    goals,
    toolOptions,
    budgets,
    availabilitySlots,
  } from '../../data/pilot';

  type ReviewStatus =
    | 'pending'
    | 'shortlist'
    | 'selected'
    | 'waitlist'
    | 'not_selected';
  type Review = { status: ReviewStatus; notes: string; updatedAt?: string };
  type Application = Record<string, unknown> & {
    id: string;
    review?: Review;
    isTest?: boolean;
    notification?: { status: string };
  };
  type Result = {
    applications?: Application[];
    selectedCount?: number;
    nextCursor?: string | null;
    notificationsConfigured?: boolean;
    review?: Review;
    notification?: { status: string };
    message?: string;
  };
  class ApiError extends Error {
    status: number;
    constructor(message: string, status: number) {
      super(message);
      this.status = status;
    }
  }
  class StaleRequestError extends Error {}
  const statuses: Record<ReviewStatus, string> = {
    pending: 'Pendiente',
    shortlist: 'Preselección',
    selected: 'Seleccionada',
    waitlist: 'Lista de espera',
    not_selected: 'No seleccionada',
  };
  const notificationLabels: Record<string, string> = {
    sent: 'Aviso enviado',
    pending: 'Aviso pendiente',
    failed: 'El aviso falló',
    unconfigured: 'Avisos sin configurar',
    skipped: 'Aviso omitido',
  };
  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  const loginForm = $<HTMLFormElement>('login-form');
  const secret = $<HTMLInputElement>('review-secret');
  const access = $('access-panel');
  const workspace = $('workspace');
  const feedback = $('feedback');
  const body = $('applications');
  const search = $<HTMLInputElement>('search');
  const filter = $<HTMLSelectElement>('status-filter');
  const showTests = $<HTMLInputElement>('show-tests');
  const loadMore = $<HTMLButtonElement>('load-more');
  const refresh = $<HTMLButtonElement>('refresh');
  const exportButton = $<HTMLButtonElement>('export');
  let applications: Application[] = [];
  let selectedCount = 0;
  let nextCursor: string | null = null;
  let notificationsConfigured = false;
  let busy = false;
  let sessionGeneration = 0;
  const drafts = new Map<string, Review>();
  const expanded = new Set<string>();

  const printable = (value: unknown): string => {
    if (Array.isArray(value)) return value.map(printable).join(', ');
    return typeof value === 'string' || typeof value === 'number'
      ? String(value)
      : '';
  };
  const label = (
    value: unknown,
    options: readonly { value: string; label: string }[],
  ) =>
    options.find((option) => option.value === printable(value))?.label ||
    printable(value) ||
    'No indicado';
  const toolLabels = (application: Application) =>
    Array.isArray(application.tools)
      ? application.tools.map((value) => label(value, toolOptions)).join(', ')
      : printable(application.tools) ||
        printable(application.information) ||
        'No indicado';
  const timeLabels = (application: Application) => {
    const times = Array.isArray(application.availability)
      ? application.availability
      : [application.availability];
    return (
      times
        .map((value) => {
          const slot = availabilitySlots.find((item) => item.value === value);
          return slot ? `${slot.day}: ${slot.label}` : printable(value);
        })
        .filter(Boolean)
        .join(' · ') || 'No indicado'
    );
  };
  const reviewOf = (application: Application): Review =>
    application.review || { status: 'pending', notes: '' };
  const isTest = (application: Application) =>
    application.isTest === true ||
    /@example\.invalid$/i.test(printable(application.email));
  const normalize = (text: string) =>
    text
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase();
  const dateLabel = (value: unknown) => {
    const date = new Date(printable(value));
    return Number.isNaN(date.getTime())
      ? 'No indicada'
      : new Intl.DateTimeFormat('es-EC', {
          dateStyle: 'medium',
          timeStyle: 'short',
          timeZone: 'America/Guayaquil',
        }).format(date);
  };
  const visibleApplications = () =>
    applications.filter((application) => {
      if (!showTests.checked && isTest(application)) return false;
      if (
        filter.value !== 'all' &&
        reviewOf(application).status !== filter.value
      )
        return false;
      const searchable = [
        ...Object.values(application).map(printable),
        label(application.role, roles),
        label(application.goal, goals),
        toolLabels(application),
        timeLabels(application),
        reviewOf(application).notes,
      ].join(' ');
      return normalize(searchable).includes(normalize(search.value.trim()));
    });

  function tell(message: string, error = false) {
    feedback.textContent = message;
    feedback.hidden = !message;
    feedback.classList.toggle('error', error);
  }
  function lock() {
    sessionGeneration += 1;
    busy = false;
    applications = [];
    drafts.clear();
    expanded.clear();
    search.value = '';
    filter.value = 'all';
    showTests.checked = false;
    tell('');
    nextCursor = null;
    selectedCount = 0;
    body.replaceChildren();
    workspace.hidden = true;
    access.hidden = false;
    secret.value = '';
  }
  async function api(
    payload?: Record<string, unknown>,
    cursor?: string,
  ): Promise<Result> {
    const generation = sessionGeneration;
    const response = await fetch(
      `/api/pilot-admin${cursor ? `?cursor=${encodeURIComponent(cursor)}` : ''}`,
      {
        method: payload ? 'POST' : 'GET',
        credentials: 'same-origin',
        cache: 'no-store',
        headers: {
          Accept: 'application/json',
          ...(payload ? { 'Content-Type': 'application/json' } : {}),
        },
        ...(payload ? { body: JSON.stringify(payload) } : {}),
      },
    );
    const data = (await response.json().catch(() => ({}))) as Result;
    if (generation !== sessionGeneration) throw new StaleRequestError();
    if (response.status === 401) lock();
    if (!response.ok)
      throw new ApiError(
        data.message ||
          'No se pudo completar la solicitud. Inténtalo de nuevo.',
        response.status,
      );
    return data;
  }
  function text<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    value: string,
    className?: string,
  ) {
    const element = document.createElement(tag);
    element.textContent = value;
    if (className) element.className = className;
    return element;
  }
  function detailList(application: Application) {
    const list = document.createElement('dl');
    const fields: [string, string][] = [
      ['WhatsApp', printable(application.whatsapp) || 'No indicado'],
      ['País', printable(application.country) || 'No indicado'],
      ['Proyecto', printable(application.project) || 'No indicado'],
      ['Origen', printable(application.source) || 'No indicado'],
      ['Enviada', dateLabel(application.submittedAt)],
      ['ID', application.id],
    ];
    for (const [name, value] of fields) {
      list.append(text('dt', name), text('dd', value));
    }
    return list;
  }
  function render() {
    const visible = visibleApplications();
    $('selected-count').textContent = String(selectedCount);
    $('results-count').textContent =
      `${visible.length} visibles · ${applications.length} cargadas${nextCursor ? ' · Hay más por cargar' : ''}`;
    loadMore.hidden = !nextCursor;
    exportButton.disabled = !visible.length;
    const notificationStatus = $('notification-status');
    notificationStatus.textContent = notificationsConfigured
      ? 'Avisos a villafortech@gmail.com configurados. Revisa el estado de cada envío en los detalles.'
      : 'Los avisos por correo aún no están configurados. Las aplicaciones guardadas siguen disponibles aquí.';
    notificationStatus.classList.toggle('error', !notificationsConfigured);
    const empty = $('empty-state');
    empty.hidden = !!visible.length;
    empty.textContent = applications.length
      ? 'No hay aplicaciones que coincidan con esta vista. Puedes cambiar los filtros o mostrar las pruebas.'
      : 'Todavía no hay aplicaciones guardadas.';
    body.replaceChildren();
    for (const application of visible) {
      const row = document.createElement('tr');
      const cell = (title: string) => {
        const result = document.createElement('td');
        result.dataset.label = title;
        row.append(result);
        return result;
      };
      const person = cell('Persona');
      person.append(
        text('strong', printable(application.name) || 'Sin nombre'),
        text('p', printable(application.email), 'small'),
      );
      if (isTest(application)) person.append(text('span', 'Prueba', 'badge'));
      const profile = cell('Área y objetivo');
      profile.append(
        text('p', label(application.role || application.occupation, roles)),
        text(
          'p',
          label(application.goal || application.challenge, goals),
          'small',
        ),
      );
      cell('Herramientas').textContent = toolLabels(application);
      cell('Presupuesto mensual').textContent = label(
        application.budget,
        budgets,
      );
      cell('Disponibilidad').textContent = timeLabels(application);
      const reviewCell = cell('Revisión');
      const current = reviewOf(application);
      const draft = drafts.get(application.id) || current;
      const badge = text(
        'span',
        statuses[current.status] || 'Pendiente',
        `badge ${current.status}`,
      );
      reviewCell.append(badge);
      const details = document.createElement('details');
      details.open = expanded.has(application.id);
      details.addEventListener('toggle', () => {
        if (details.open) expanded.add(application.id);
        else expanded.delete(application.id);
      });
      details.append(text('summary', 'Ver y revisar'));
      details.append(detailList(application));
      const form = document.createElement('form');
      form.method = 'post';
      form.action = '/api/pilot-admin';
      const statusLabel = text('label', 'Estado de la aplicación');
      const statusSelect = document.createElement('select');
      statusSelect.id = `status-${application.id}`;
      statusLabel.htmlFor = statusSelect.id;
      for (const [value, caption] of Object.entries(statuses)) {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = caption;
        option.selected = value === draft.status;
        option.disabled =
          value === 'selected' &&
          current.status !== 'selected' &&
          selectedCount >= 5;
        statusSelect.append(option);
      }
      const notesLabel = text('label', 'Notas privadas (opcional)');
      const notes = document.createElement('textarea');
      notes.id = `notes-${application.id}`;
      notesLabel.htmlFor = notes.id;
      notes.rows = 3;
      notes.maxLength = 2000;
      notes.value = draft.notes;
      const rememberDraft = () =>
        drafts.set(application.id, {
          status: statusSelect.value as ReviewStatus,
          notes: notes.value,
        });
      statusSelect.addEventListener('change', rememberDraft);
      notes.addEventListener('input', rememberDraft);
      const save = text('button', 'Guardar revisión');
      save.type = 'submit';
      const result = text('p', '', 'small');
      result.setAttribute('role', 'status');
      result.setAttribute('aria-live', 'polite');
      form.append(statusLabel, statusSelect, notesLabel, notes, save, result);
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        save.disabled = true;
        statusSelect.disabled = true;
        notes.disabled = true;
        result.textContent = 'Guardando…';
        try {
          const data = await api({
            action: 'review',
            id: application.id,
            status: statusSelect.value,
            notes: notes.value,
          });
          application.review = data.review || {
            status: statusSelect.value as ReviewStatus,
            notes: notes.value,
          };
          selectedCount = data.selectedCount ?? selectedCount;
          drafts.delete(application.id);
          render();
          tell(
            `Revisión de ${printable(application.name)} guardada. No se enviaron mensajes a la persona.`,
          );
        } catch (error) {
          if (error instanceof StaleRequestError) return;
          result.textContent =
            error instanceof Error
              ? error.message
              : 'No se pudo guardar la revisión.';
          tell(result.textContent, true);
        } finally {
          save.disabled = false;
          statusSelect.disabled = false;
          notes.disabled = false;
        }
      });
      details.append(form);
      const notification =
        application.notification?.status ||
        (notificationsConfigured ? 'pending' : 'unconfigured');
      const mailStatus = text(
        'p',
        notificationLabels[notification] || 'Estado del aviso no disponible',
        'small',
      );
      details.append(mailStatus);
      if (notification !== 'sent' && notificationsConfigured) {
        const retry = text('button', 'Reintentar aviso', 'secondary');
        retry.type = 'button';
        retry.addEventListener('click', async () => {
          retry.disabled = true;
          mailStatus.textContent = 'Enviando aviso a villafortech@gmail.com…';
          try {
            const data = await api({ action: 'notify', id: application.id });
            if (data.notification) application.notification = data.notification;
            mailStatus.textContent =
              notificationLabels[
                application.notification?.status || 'pending'
              ] || 'Aviso solicitado';
            retry.hidden = application.notification?.status === 'sent';
          } catch (error) {
            if (error instanceof StaleRequestError) return;
            mailStatus.textContent =
              error instanceof Error
                ? error.message
                : 'No se pudo enviar el aviso.';
          } finally {
            retry.disabled = false;
          }
        });
        details.append(retry);
      }
      reviewCell.append(details);
      body.append(row);
    }
  }
  async function load(reset = true, silent = false) {
    if (busy) return;
    busy = true;
    const generation = sessionGeneration;
    refresh.disabled = true;
    loadMore.disabled = true;
    workspace.setAttribute('aria-busy', 'true');
    try {
      const data = await api(
        undefined,
        reset ? undefined : nextCursor || undefined,
      );
      applications = reset
        ? data.applications || []
        : Array.from(
            new Map(
              [...applications, ...(data.applications || [])].map(
                (application) => [application.id, application],
              ),
            ).values(),
          );
      selectedCount = data.selectedCount ?? 0;
      nextCursor = data.nextCursor || null;
      notificationsConfigured = data.notificationsConfigured === true;
      access.hidden = true;
      workspace.hidden = false;
      render();
      if (!silent) tell('Respuestas actualizadas.');
    } catch (error) {
      if (error instanceof StaleRequestError) return;
      if (!silent || !(error instanceof ApiError && error.status === 401))
        tell(
          error instanceof Error
            ? error.message
            : 'No se pudieron cargar las respuestas.',
          true,
        );
    } finally {
      if (generation === sessionGeneration) {
        busy = false;
        refresh.disabled = false;
        loadMore.disabled = false;
        workspace.setAttribute('aria-busy', 'false');
      }
    }
  }
  loginForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    sessionGeneration += 1;
    busy = false;
    const submit = loginForm.querySelector('button')!;
    submit.disabled = true;
    tell('Iniciando sesión…');
    try {
      await api({ action: 'login', secret: secret.value });
      secret.value = '';
      await load();
    } catch (error) {
      if (error instanceof StaleRequestError) return;
      tell(
        error instanceof Error ? error.message : 'No se pudo iniciar sesión.',
        true,
      );
    } finally {
      submit.disabled = false;
    }
  });
  $('logout').addEventListener('click', async () => {
    lock();
    const submit = loginForm.querySelector('button')!;
    submit.disabled = true;
    try {
      await api({ action: 'logout' });
      tell('Sesión cerrada.');
      secret.focus();
    } catch (error) {
      if (error instanceof StaleRequestError) return;
      tell(
        error instanceof Error
          ? error.message
          : 'No se pudo cerrar la sesión. Inténtalo de nuevo.',
        true,
      );
    } finally {
      submit.disabled = false;
    }
  });
  search.addEventListener('input', render);
  filter.addEventListener('change', render);
  showTests.addEventListener('change', render);
  refresh.addEventListener('click', () => load());
  loadMore.addEventListener('click', () => load(false));
  exportButton.addEventListener('click', () => {
    const csvCell = (value: string) =>
      `"${(/^[\s]*[=+\-@]|^[\t\r\n]/.test(value) ? `'${value}` : value).replaceAll('"', '""')}"`;
    const rows = [
      [
        'Nombre',
        'Correo',
        'Área',
        'Objetivo',
        'Herramientas',
        'Presupuesto mensual',
        'Disponibilidad (Ecuador)',
        'WhatsApp',
        'País',
        'Proyecto',
        'Origen',
        'Fecha (Ecuador)',
        'Estado',
        'Notas privadas',
        'Prueba',
        'ID',
      ],
      ...visibleApplications().map((application) => [
        printable(application.name),
        printable(application.email),
        label(application.role || application.occupation, roles),
        label(application.goal || application.challenge, goals),
        toolLabels(application),
        label(application.budget, budgets),
        timeLabels(application),
        printable(application.whatsapp),
        printable(application.country),
        printable(application.project),
        printable(application.source),
        dateLabel(application.submittedAt),
        statuses[reviewOf(application).status],
        reviewOf(application).notes,
        isTest(application) ? 'Sí' : 'No',
        application.id,
      ]),
    ];
    const blob = new Blob(
      ['\uFEFF' + rows.map((row) => row.map(csvCell).join(',')).join('\r\n')],
      { type: 'text/csv;charset=utf-8' },
    );
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement('a');
    anchor.href = url;
    anchor.download = 'aplicaciones-segundo-cerebro-vista.csv';
    anchor.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    tell(
      `CSV descargado con las ${visibleApplications().length} aplicaciones visibles. Guarda el archivo en un lugar privado.`,
    );
  });
  // Check an existing HttpOnly session once; never persist applicant data in browser storage.
  void load(true, true);
  window.addEventListener('pagehide', lock);
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) void load(true, true);
  });
</script>

<style is:global>
  .review-header,
  .review-shell,
  .review-footer {
    width: min(calc(100% - 48px), 1500px);
    margin-inline: auto;
  }
  .review-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-block: 24px;
    border-bottom: 1px solid var(--line);
  }
  .review-header img {
    width: 200px;
