---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('writing', ({ data }) => !data.draft);
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout
  title="Writing"
  description="Notes on building ML systems — evaluation strategies, monitoring patterns, and lessons from production."
>
  <Section>
    <h1 class="text-3xl sm:text-4xl font-semibold mb-4">Writing</h1>
    <p class="text-gray-600 mb-8 max-w-2xl">
      Notes on building ML systems — evaluation strategies, monitoring patterns, and lessons from production. Short, practical, systems-focused.
    </p>

    {sortedPosts.length > 0 ? (
      <div class="grid gap-6">
        {sortedPosts.map((post) => (
          <Card
            title={post.data.title}
            summary={post.data.summary}
            href={`/writing/${post.data.slug}`}
            tags={post.data.tags}
            date={post.data.date}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-12 text-gray-500">
        <p>No posts yet. Check back soon.</p>
      </div>
    )}
  </Section>
</BaseLayout>
