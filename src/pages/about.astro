---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import profileEn from '../data/profile';
import profileEs from '../data/profile.es';
import { localeRoutes, type Locale } from '../i18n';
interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const profile = locale === 'es' ? profileEs : profileEn;
const routes = localeRoutes[locale];
const copy = {
  en: {
    title: 'About',
    description:
      'Roberto Villafuerte: from Puyo to engineering AI and data systems. The experiences, questions, and people behind the work.',
    eyebrow: 'The person behind the work',
    heading: 'Curiosity brought me here.',
    intro:
      'I grew up in Puyo, in the Ecuadorian Amazon. Today I build AI and data systems, and keep asking how they work and what they make possible.',
    photo:
      'Roberto Villafuerte next to a portrait of Linus Torvalds at the University of Helsinki',
    caption: 'University of Helsinki / Linus Torvalds Auditorium',
    timeline: 'Places along the way',
    headings: [
      'A first question.',
      'The chance to study.',
      'Looking beyond the model.',
      'Learning in different contexts.',
      'What I am building toward.',
    ],
    education: 'Education',
    educationTitle: 'A foundation to keep building on.',
    resume: 'Read the résumé',
    projects: 'Explore the projects',
  },
  es: {
    title: 'Sobre mí',
    description:
      'Roberto Villafuerte: de Puyo a la ingeniería de sistemas de IA y datos. Las experiencias, preguntas y personas detrás del trabajo.',
    eyebrow: 'La persona detrás del trabajo',
    heading: 'La curiosidad me trajo hasta aquí.',
    intro:
      'Crecí en Puyo, en la Amazonía ecuatoriana. Hoy construyo sistemas de IA y datos, y sigo preguntándome cómo funcionan y qué hacen posible.',
    photo:
      'Roberto Villafuerte junto a un retrato de Linus Torvalds en la Universidad de Helsinki',
    caption: 'Universidad de Helsinki / Auditorio Linus Torvalds',
    timeline: 'Lugares del camino',
    headings: [
      'Una primera pregunta.',
      'La oportunidad de estudiar.',
      'Mirar más allá del modelo.',
      'Aprender en distintos contextos.',
      'Hacia dónde quiero ir.',
    ],
    education: 'Formación',
    educationTitle: 'Una base para seguir construyendo.',
    resume: 'Ver el currículum',
    projects: 'Explorar los proyectos',
  },
}[locale];
---

<BaseLayout title={copy.title} description={copy.description} locale={locale}>
  <section class="about-opening shell">
    <div class="about-opening__grid">
      <div class="about-opening__copy">
        <p class="eyebrow">{copy.eyebrow}</p><h1>{copy.heading}</h1><p>
          {copy.intro}
        </p>
      </div>
      <figure>
        <picture>
          <source
            type="image/avif"
            srcset="/images/roberto-linus-torvalds-auditorium-384.avif 384w, /images/roberto-linus-torvalds-auditorium-768.avif 768w"
            sizes="(max-width: 760px) min(calc(100vw - 48px), 360px), 330px"
          />
          <source
            type="image/webp"
            srcset="/images/roberto-linus-torvalds-auditorium-384.webp 384w, /images/roberto-linus-torvalds-auditorium-768.webp 768w"
            sizes="(max-width: 760px) min(calc(100vw - 48px), 360px), 330px"
          />
          <img
            src="/images/roberto-linus-torvalds-auditorium.jpeg"
            width="768"
            height="1024"
            alt={copy.photo}
            decoding="async"
          />
        </picture>
        <figcaption>{copy.caption}</figcaption>
      </figure>
    </div>
  </section>
  <section class="life-story">
    <div class="shell life-story__grid">
      <aside aria-label={copy.timeline}>
        <p class="eyebrow">{copy.timeline}</p>
        <ol class="life-story__index">
          {
            profile.story.milestones
              .filter((_, i) => [0, 1, 4].includes(i))
              .map((item) => (
                <li>
                  <>
                    <strong>{item.place}</strong>
                    <small>{item.detail}</small>
                  </>
                </li>
              ))
          }
        </ol>
      </aside>
      <div class="life-story__copy">
        {
          profile.story.paragraphs.map((paragraph, i) => (
            <section>
              <>
                <h2>{copy.headings[i]}</h2>
                <p>{paragraph}</p>
              </>
            </section>
          ))
        }
      </div>
    </div>
  </section>
  <section class="education-block">
    <div class="shell education-block__layout">
      <div>
        <p class="eyebrow">{copy.education}</p><h2>{copy.educationTitle}</h2>
      </div>
      <div>
        <div class="education-ledger">
          {
            profile.education.map((item) => (
              <article>
                <>
                  <span>{item.period}</span>
                  <h3>{item.institution}</h3>
                  <p class="education-ledger__program">{item.program}</p>
                  <p>{item.detail}</p>
                </>
              </article>
            ))
          }
        </div><div class="narrative-actions">
          <Button href={routes.resume}>{copy.resume}</Button><a
            class="plain-link"
            href={routes.projects}
            >{copy.projects}<span aria-hidden="true">→</span></a
          >
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
