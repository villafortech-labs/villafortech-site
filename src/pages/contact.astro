---
import BaseLayout from '../layouts/BaseLayout.astro';
import profileEn from '../data/profile';
import profileEs from '../data/profile.es';
import { sharedCopy, type Locale } from '../i18n';
interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const profile = locale === 'es' ? profileEs : profileEn;
const shared = sharedCopy[locale];
const copy = {
  en: {
    title: 'Contact',
    description:
      'Contact Roberto Villafuerte to talk about AI and data systems, exchange ideas, or explore a technical collaboration.',
    eyebrow: 'Let’s talk',
    heading: 'A good question is a good start.',
    deck: 'Projects, ideas, something that failed or something you are trying to understand. If it connects with my work, I’d like to hear about it.',
    note: 'A little context helps: what you are exploring, where you got stuck, and what you have tried.',
    email: '01 / Email',
    connect: '02 / Conversation',
    code: '03 / Code and evidence',
    location: 'Writing and building from Quito, Ecuador.',
  },
  es: {
    title: 'Contacto',
    description:
      'Contacta a Roberto Villafuerte para conversar sobre sistemas de IA y datos, intercambiar ideas o explorar una colaboración técnica.',
    eyebrow: 'Conversemos',
    heading: 'Una buena pregunta es un buen comienzo.',
    deck: 'Proyectos, ideas, algo que falló o algo que estás intentando entender. Si conecta con mi trabajo, me gustará conocerlo.',
    note: 'Un poco de contexto ayuda: qué estás explorando, dónde te atascaste y qué has intentado.',
    email: '01 / Correo',
    connect: '02 / Conversación',
    code: '03 / Código y evidencia',
    location: 'Escribo y construyo desde Quito, Ecuador.',
  },
}[locale];
---

<BaseLayout title={copy.title} description={copy.description} locale={locale}>
  <section class="contact-page">
    <div class="shell contact-page__grid">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p><h1>{copy.heading}</h1><p
          class="contact-page__deck"
        >
          {copy.deck}
        </p><p class="contact-note">{copy.note}</p>
      </div>
      <div>
        <div class="contact-ledger" id="brief">
          <a
            class="contact-line contact-line--primary"
            href={profile.links.email}
            ><span>{copy.email}</span><strong
              >{profile.links.emailAddress}</strong
            ><span aria-hidden="true">↗</span></a
          >
          <a
            class="contact-line"
            href={profile.links.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            ><span>{copy.connect}</span><strong>LinkedIn</strong><span
              aria-hidden="true">↗</span
            ><span class="sr-only">{shared.newTab}</span></a
          >
          <a
            class="contact-line"
            href={profile.links.github}
            target="_blank"
            rel="noopener noreferrer"
            ><span>{copy.code}</span><strong>GitHub</strong><span
              aria-hidden="true">↗</span
            ><span class="sr-only">{shared.newTab}</span></a
          >
        </div><p class="contact-location">{copy.location}</p>
      </div>
    </div>
  </section>
</BaseLayout>
