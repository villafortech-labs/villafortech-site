---
import BaseLayout from '../layouts/BaseLayout.astro';
import profileEn from '../data/profile';
import profileEs from '../data/profile.es';
import { sharedCopy, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const profile = locale === 'es' ? profileEs : profileEn;
const shared = sharedCopy[locale];
const copy = {
  en: {
    title: 'Work with me',
    description:
      'Work with Roberto Villafuerte on AI systems architecture, data foundations, technical collaboration, startup opportunities, or speaking.',
    eyebrow: 'Work with me / Quito, Ecuador',
    heading: 'Bring me the difficult system boundary.',
    deck: 'If an ambitious product idea is running into questions of AI, data, architecture, or execution, I can help make the system and the next move clearer.',
    available: 'Available for independent consulting',
    email: '01 / Email',
    connect: '02 / Connect',
    code: '03 / Code',
    note: 'A useful first message includes what you are building, the constraint that matters, and what a strong outcome would look like.',
    sectionEyebrow: 'Ways to work together / 01',
    sectionTitle: 'A focused engagement, or a bigger conversation.',
    sectionDeck:
      'I work best with people who care about the product and the underlying system, not just the appearance of an AI feature.',
    cards: [
      {
        title: 'Independent consulting',
        detail:
          'Focused architecture discovery, system review, data-flow design, and an implementation path your team can act on.',
      },
      {
        title: 'Technical collaboration',
        detail:
          'Targeted work across AI capabilities, data foundations, backend services, and the control paths that connect them.',
      },
      {
        title: 'Startup opportunities',
        detail:
          'Early-stage roles and founder-minded conversations around products where technically difficult work creates real leverage.',
      },
      {
        title: 'Speaking',
        detail:
          'Practical conversations about AI systems, trustworthy ML, data architecture, and the path from a model to a product.',
      },
    ],
  },
  es: {
    title: 'Trabajemos juntos',
    description:
      'Trabaja con Roberto Villafuerte en arquitectura de sistemas de IA, fundamentos de datos, colaboración técnica, oportunidades en startups o conferencias.',
    eyebrow: 'Trabajemos juntos / Quito, Ecuador',
    heading: 'Hablemos del punto donde el sistema se complica.',
    deck: 'Si una idea de producto ambiciosa se está topando con preguntas de IA, datos, arquitectura o ejecución, puedo ayudarte a aclarar el sistema y el siguiente paso.',
    available: 'Disponible para consultoría independiente',
    email: '01 / Correo',
    connect: '02 / Contacto',
    code: '03 / Código',
    note: 'Un buen primer mensaje incluye qué estás construyendo, cuál es la restricción que importa y cómo se vería un buen resultado.',
    sectionEyebrow: 'Formas de trabajar juntos / 01',
    sectionTitle: 'Una colaboración puntual o una conversación más amplia.',
    sectionDeck:
      'Trabajo mejor con personas que se preocupan tanto por el producto como por el sistema que lo sostiene, no solo por mostrar una función con IA.',
    cards: [
      {
        title: 'Consultoría independiente',
        detail:
          'Diagnóstico de arquitectura, revisión del sistema, diseño de flujos de datos y una ruta de implementación concreta para el equipo.',
      },
      {
        title: 'Colaboración técnica',
        detail:
          'Trabajo puntual en capacidades de IA, fundamentos de datos, servicios backend y los flujos de control que los conectan.',
      },
      {
        title: 'Oportunidades en startups',
        detail:
          'Roles en etapas tempranas y conversaciones con mentalidad de fundador sobre productos en los que el trabajo técnicamente difícil genera una ventaja real.',
      },
      {
        title: 'Conferencias',
        detail:
          'Charlas prácticas sobre sistemas de IA, aprendizaje automático confiable, arquitectura de datos y el camino de un modelo a un producto.',
      },
    ],
  },
}[locale];
---

<BaseLayout title={copy.title} description={copy.description} locale={locale}>
  <section class="contact-page">
    <div class="shell contact-page__grid">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.heading}</h1>
        <p class="contact-page__deck">{copy.deck}</p>
        <p class="availability-line">
          <span aria-hidden="true"></span>
          {copy.available}
        </p>
      </div>

      <div class="contact-ledger">
        <a
          class="contact-line contact-line--primary"
          href={profile.links.email}
        >
          <span>{copy.email}</span>
          <strong>{profile.links.emailAddress}</strong>
          <span aria-hidden="true">↗</span>
        </a>
        <a
          class="contact-line"
          href={profile.links.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>{copy.connect}</span>
          <strong>LinkedIn</strong>
          <span aria-hidden="true">↗</span>
          <span class="sr-only">{shared.newTab}</span>
        </a>
        <a
          class="contact-line"
          href={profile.links.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>{copy.code}</span>
          <strong>GitHub</strong>
          <span aria-hidden="true">↗</span>
          <span class="sr-only">{shared.newTab}</span>
        </a>
        <p class="contact-note">{copy.note}</p>
      </div>
    </div>
  </section>

  <section
    class="collaboration-section"
    aria-labelledby="collaboration-heading"
  >
    <div class="shell">
      <header class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">{copy.sectionEyebrow}</p>
          <h2 id="collaboration-heading">{copy.sectionTitle}</h2>
        </div>
        <p>{copy.sectionDeck}</p>
      </header>

      <ol class="collaboration-grid">
        {
          copy.cards.map((card, index) => (
            <li
              class:list={[
                'collaboration-card',
                index === 0 && 'collaboration-card--featured',
              ]}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{card.title}</h3>
              <p>{card.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>
