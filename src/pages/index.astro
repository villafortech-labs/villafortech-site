---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import profileEn from '../data/profile';
import profileEs from '../data/profile.es';
import { localeRoutes, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const profile = locale === 'es' ? profileEs : profileEn;
const routes = localeRoutes[locale];
const copy = {
  en: {
    verbs: ['I build, test', 'and explain.'],
    subject: 'AI and data systems.',
    projects: 'Explore the projects',
    about: 'A little about me',
    chapter: '01 / Selected work',
    workTitle: 'Ideas, put to the test.',
    workDeck:
      'The problem, the decisions, and the evidence. What was built, and what remains to be validated.',
    public: 'Public source',
    sanitized: 'Sanitized engineering note',
    private: 'Private work',
    read: 'Read the case study',
    all: 'All projects',
    focusLabel: 'What to look for',
    focus: [
      'Separate model fitting, policy selection, and held-out measurement.',
      'Follow the evidence from the data to the governance verdict.',
      'Read the evaluation limits alongside the results.',
    ],
    practice: '02 / Engineering practice',
    practiceTitle: 'Look past the model.',
    practiceDeck:
      'I work where data, software, and models meet. Understanding their connections shapes what I build and how I test it.',
    story: '03 / The person behind the work',
    storyTitle: 'From Puyo, with curiosity.',
    storyLink: 'Read my story',
    storyNote: 'Think rigorously. Live curiously.',
    contactLabel: 'Keep the conversation going',
    contactTitle: 'What are you exploring?',
    contactDeck:
      'If a project raises a question, or our interests overlap, I’d like to hear from you.',
    contact: 'Get in touch',
  },
  es: {
    verbs: ['Construyo, pruebo', 'y explico.'],
    subject: 'Sistemas de IA y datos.',
    projects: 'Explorar los proyectos',
    about: 'Un poco sobre mí',
    chapter: '01 / Proyectos seleccionados',
    workTitle: 'Ideas que pasan por la prueba.',
    workDeck:
      'El problema, las decisiones y la evidencia. Qué se construyó y qué queda por validar.',
    public: 'Código público',
    sanitized: 'Nota sin información sensible',
    private: 'Trabajo privado',
    read: 'Leer el caso de estudio',
    all: 'Todos los proyectos',
    focusLabel: 'Dónde poner la atención',
    focus: [
      'Separar ajuste del modelo, selección de políticas y medición reservada.',
      'Seguir la evidencia desde los datos hasta el veredicto de gobernanza.',
      'Leer los límites de la evaluación junto con los resultados.',
    ],
    practice: '02 / Práctica de ingeniería',
    practiceTitle: 'Mirar más allá del modelo.',
    practiceDeck:
      'Trabajo donde se encuentran datos, software y modelos. Entender sus conexiones guía lo que construyo y cómo lo pongo a prueba.',
    story: '03 / La persona detrás del trabajo',
    storyTitle: 'Desde Puyo, con curiosidad.',
    storyLink: 'Conocer mi historia',
    storyNote: 'Pensar con rigor. Vivir con curiosidad.',
    contactLabel: 'Sigamos la conversación',
    contactTitle: '¿Qué estás explorando?',
    contactDeck:
      'Si un proyecto te dejó una pregunta o compartimos algún interés, me gustará leerte.',
    contact: 'Escríbeme',
  },
}[locale];
const projects = (
  await getCollection(
    'projects',
    ({ data }) =>
      data.evidence !== 'hold' && data.locale === locale && data.featured,
  )
)
  .sort((a, b) => (a.data.featuredOrder ?? 99) - (b.data.featuredOrder ?? 99))
  .slice(0, 3);
const flagship = projects.at(0);
const projectPath = (project: (typeof projects)[number]) =>
  `${routes.projects}/${project.data.translationKey ?? project.data.slug}/`;
const evidenceLabel = (evidence?: string) =>
  evidence === 'public'
    ? copy.public
    : evidence === 'sanitized'
      ? copy.sanitized
      : copy.private;
---

<BaseLayout
  title={profile.name}
  description={profile.positioning.statement}
  locale={locale}
>
  <section class="intro shell" aria-labelledby="intro-title">
    <div class="intro__copy">
      <p class="intro__byline">
        <span>{profile.headline}</span><span>{profile.location}</span>
      </p>
      <h1 id="intro-title">
        {copy.verbs.map((line) => <span>{line} </span>)}
        <em>{copy.subject}</em>
      </h1>
      <p class="intro__description">{profile.positioning.detail}</p>
      <div class="intro__actions">
        <Button href={routes.projects} size="lg"
          >{copy.projects}<span aria-hidden="true">↗</span></Button
        >
        <a class="plain-link" href={routes.about}
          >{copy.about}<span aria-hidden="true">→</span></a
        >
      </div>
    </div>
    <figure class="intro__portrait">
      <picture>
        <source
          type="image/avif"
          srcset="/images/roberto-villafuerte-portrait-362.avif 362w, /images/roberto-villafuerte-portrait-724.avif 724w"
          sizes="(max-width: 760px) min(calc(100vw - 48px), 360px), 360px"
        />
        <source
          type="image/webp"
          srcset="/images/roberto-villafuerte-portrait-362.webp 362w, /images/roberto-villafuerte-portrait-724.webp 724w"
          sizes="(max-width: 760px) min(calc(100vw - 48px), 360px), 360px"
        />
        <img
          src="/images/roberto-villafuerte-portrait.jpeg"
          width="724"
          height="1086"
          alt="Roberto Villafuerte"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <figcaption>
        <span>Roberto Villafuerte</span><span>{profile.headline}</span>
      </figcaption>
    </figure>
  </section>

  <section
    class="selected-work section-space"
    aria-labelledby="selected-work-title"
  >
    <div class="shell">
      <header class="chapter-heading" data-reveal>
        <div>
          <p class="eyebrow">{copy.chapter}</p><h2 id="selected-work-title">
            {copy.workTitle}
          </h2>
        </div>
        <p>{copy.workDeck}</p>
      </header>
      {
        flagship && (
          <article class="project-feature" data-reveal>
            <div class="project-feature__main">
              <div class="project-feature__meta">
                <>
                  <span>01</span>
                  <span>{evidenceLabel(flagship.data.evidence)}</span>
                </>
              </div>
              <h3>
                <a href={projectPath(flagship)}>
                  {flagship.data.shortTitle || flagship.data.title}
                </a>
              </h3>
              <p>{flagship.data.summary}</p>
              <a class="plain-link" href={projectPath(flagship)}>
                {copy.read}
                <span aria-hidden="true">↗</span>
              </a>
            </div>
            <div class="project-feature__notes">
              <p class="eyebrow">{copy.focusLabel}</p>
              <ol>
                {copy.focus.map((item, index) => (
                  <li>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <p>{item}</p>
                  </li>
                ))}
              </ol>
            </div>
          </article>
        )
      }
      <div class="project-pair">
        {
          projects.slice(1).map((project, index) => (
            <article class="project-note" data-reveal>
              <div class="project-note__meta">
                <>
                  <span>{String(index + 2).padStart(2, '0')}</span>
                  <span>{project.data.organization || project.data.role}</span>
                </>
              </div>
              <h3>
                <a href={projectPath(project)}>
                  {project.data.shortTitle || project.data.title}
                </a>
              </h3>
              <p>{project.data.summary}</p>
              <p class="project-note__evidence">
                {evidenceLabel(project.data.evidence)}
              </p>
              <a class="plain-link" href={projectPath(project)}>
                {copy.read}
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))
        }
      </div>
      <div class="section-end">
        <a class="plain-link" href={routes.projects}
          >{copy.all}<span aria-hidden="true">→</span></a
        >
      </div>
    </div>
  </section>

  <section class="practice section-space" aria-labelledby="practice-title">
    <div class="shell practice__layout" data-reveal>
      <header>
        <p class="eyebrow">{copy.practice}</p><h2 id="practice-title">
          {copy.practiceTitle}
        </h2><p>{copy.practiceDeck}</p>
      </header>
      <ol class="practice__list">
        {
          profile.services.map((service, index) => (
            <li>
              <>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <>
                    <h3>{service.title}</h3>
                    <p>{service.detail}</p>
                  </>
                </div>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="origin section-space" aria-labelledby="origin-title">
    <div class="shell origin__layout" data-reveal>
      <div class="origin__heading">
        <p class="eyebrow">{copy.story}</p><h2 id="origin-title">
          {copy.storyTitle}
        </h2><p class="origin__motto">{copy.storyNote}</p>
      </div>
      <div class="origin__copy">
        {
          profile.story.paragraphs
            .slice(0, 2)
            .map((paragraph) => <p>{paragraph}</p>)
        }<a class="plain-link" href={routes.about}
          >{copy.storyLink}<span aria-hidden="true">→</span></a
        >
      </div>
    </div>
  </section>

  <section class="conversation" aria-labelledby="conversation-title">
    <div class="shell conversation__layout">
      <div>
        <p class="eyebrow">{copy.contactLabel}</p><h2 id="conversation-title">
          {copy.contactTitle}
        </h2>
      </div><div>
        <p>{copy.contactDeck}</p><Button
          href={routes.contact}
          variant="secondary"
          >{copy.contact}<span aria-hidden="true">↗</span></Button
        >
      </div>
    </div>
  </section>
</BaseLayout>
