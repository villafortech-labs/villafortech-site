---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import profileEn from '../data/profile';
import profileEs from '../data/profile.es';
import { localeRoutes, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const profile = locale === 'es' ? profileEs : profileEn;
const routes = localeRoutes[locale];
const copy = {
  en: {
    description:
      'Roberto Villafuerte works with founders and engineering leaders on the AI, data, and backend systems behind ambitious products.',
    heroEyebrow: 'AI systems & data architecture',
    workWithMe: 'Work with me',
    explore: 'Explore my work',
    selectedEvidence: 'Selected evidence',
    servicesEyebrow: 'Where I’m useful / 01',
    servicesTitle: 'Between the idea and the system that has to carry it.',
    servicesDeck:
      'I help teams make the architecture explicit: what the product needs, how its data moves, where AI belongs, and how the system should behave when the easy path fails.',
    systemsEyebrow: 'Selected systems / 02',
    systemsTitle: 'Work that made the architecture concrete.',
    systemsDeck:
      'Across health data, support automation, and trustworthy ML, the common thread is turning an ambiguous requirement into an inspectable system.',
    system: 'SYSTEM',
    flagship: 'Flagship public case',
    publicSource: 'Public source',
    boundary: 'Boundary',
    decision: 'Decision',
    evidence: 'Evidence',
    flowEyebrow: 'Decision path / one policy, four explicit stages',
    flowLabel:
      'Fairness audit flow from model fitting to the service decision rule',
    flow: [
      { title: 'Fit', detail: 'Training partition' },
      { title: 'Select', detail: 'Validation policy' },
      { title: 'Measure', detail: 'Held-out test' },
      { title: 'Serve', detail: 'Global API rule' },
    ],
    technologies: 'Technologies and topics',
    readCase: 'Read the case study',
    allWork: 'View all selected work',
    storyEyebrow: 'Path and direction / 03',
    pointOfView: 'Point of view / 04',
    closeEyebrow: 'Work with me / 05',
    closeTitle: 'Building something technically ambitious?',
    closeDeck:
      'I’m available for independent consulting, technical collaboration, startup opportunities, and speaking with teams building AI-enabled products.',
  },
  es: {
    description:
      'Roberto Villafuerte trabaja con fundadores y líderes de ingeniería en los sistemas de IA, datos y backend detrás de productos ambiciosos.',
    heroEyebrow: 'Sistemas de IA y arquitectura de datos',
    workWithMe: 'Trabajemos juntos',
    explore: 'Explora mi trabajo',
    selectedEvidence: 'Evidencia seleccionada',
    servicesEyebrow: 'Dónde aporto / 01',
    servicesTitle: 'Entre la idea y el sistema que debe sostenerla.',
    servicesDeck:
      'Ayudo a los equipos a hacer explícita la arquitectura: qué necesita el producto, cómo se mueven sus datos, dónde aporta la IA y cómo debe responder el sistema fuera del caso ideal.',
    systemsEyebrow: 'Sistemas seleccionados / 02',
    systemsTitle: 'Trabajo que llevó la arquitectura a la práctica.',
    systemsDeck:
      'En datos de salud, automatización de soporte y aprendizaje automático confiable, el hilo común es convertir requisitos ambiguos en sistemas que se pueden inspeccionar.',
    system: 'SISTEMA',
    flagship: 'Caso público principal',
    publicSource: 'Fuente pública',
    boundary: 'Límite',
    decision: 'Decisión',
    evidence: 'Evidencia',
    flowEyebrow: 'Ruta de decisión / una política, cuatro etapas explícitas',
    flowLabel:
      'Flujo de auditoría de equidad desde el ajuste del modelo hasta la regla de decisión del servicio',
    flow: [
      { title: 'Ajustar', detail: 'Partición de entrenamiento' },
      { title: 'Seleccionar', detail: 'Política de validación' },
      { title: 'Medir', detail: 'Prueba reservada' },
      { title: 'Servir', detail: 'Regla global de la API' },
    ],
    technologies: 'Tecnologías y temas',
    readCase: 'Leer el caso de estudio',
    allWork: 'Ver todos los proyectos',
    storyEyebrow: 'Camino y dirección / 03',
    pointOfView: 'Punto de vista / 04',
    closeEyebrow: 'Trabajemos juntos / 05',
    closeTitle: '¿Estás construyendo algo técnicamente ambicioso?',
    closeDeck:
      'Estoy disponible para consultoría independiente, colaboración técnica, oportunidades en startups y conferencias con equipos que construyen productos habilitados por IA.',
  },
}[locale];

const projects = await getCollection(
  'projects',
  ({ data }) => data.evidence !== 'hold' && data.locale === locale,
);
const projectIndex = new Map(
  projects.map((project) => [
    project.data.translationKey ?? project.data.slug,
    project,
  ]),
);
const featuredSystems = [...projectIndex.values()]
  .filter(
    (project) =>
      project.data.featured &&
      project.data.featuredOrder !== undefined &&
      project.data.featuredOrder <= 3,
  )
  .sort(
    (left, right) =>
      (left.data.featuredOrder ?? 99) - (right.data.featuredOrder ?? 99),
  );
const flagshipSystem = featuredSystems.at(0);
const supportingSystems = featuredSystems.slice(1);
type SystemRecord = {
  boundary: string;
  decision: string;
  evidence: string;
};
const recordsByLocale: Record<Locale, Record<string, SystemRecord>> = {
  en: {
    'fairness-aware-candidate-pre-screening': {
      boundary: 'Validation selects the policy; held-out data measures it.',
      decision: 'Offline thresholds stay separate from the API rule.',
      evidence: 'Source, run instructions, report, and artifact trail.',
    },
    'salihub-data-architecture': {
      boundary: 'Product, privacy, consent, and reporting meet in the schema.',
      decision: 'Source-aware deduplication preserves provenance.',
      evidence: 'Sanitized engineering note with private implementation.',
    },
    'compumax-rag-pipeline': {
      boundary:
        'Retrieval, routing, fallback, and human ownership share one path.',
      decision:
        'A human-only route remains explicit when automation should stop.',
      evidence: 'Sanitized engineering note with private implementation.',
    },
  },
  es: {
    'fairness-aware-candidate-pre-screening': {
      boundary:
        'La validación selecciona la política; los datos reservados la miden.',
      decision:
        'Los umbrales offline permanecen separados de la regla de la API.',
      evidence:
        'Código, instrucciones, informe y rastro de artefactos públicos.',
    },
    'salihub-data-architecture': {
      boundary:
        'Producto, privacidad, consentimiento y reportes convergen en el esquema.',
      decision:
        'La deduplicación consciente de la fuente preserva la procedencia.',
      evidence:
        'Nota de ingeniería sin detalles sensibles; implementación privada.',
    },
    'compumax-rag-pipeline': {
      boundary:
        'Recuperación, enrutamiento, contingencia y responsabilidad humana comparten una ruta.',
      decision:
        'La ruta exclusivamente humana sigue explícita cuando la automatización debe detenerse.',
      evidence:
        'Nota de ingeniería sin detalles sensibles; implementación privada.',
    },
  },
};
const systemRecords = recordsByLocale[locale];
const homeStoryParagraphs = profile.story.paragraphs.slice(2);
const homeStoryMilestones = profile.story.milestones.slice(1);
---

<BaseLayout title={profile.name} description={copy.description} locale={locale}>
  <section class="hero">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="eyebrow" data-enter="1">{copy.heroEyebrow}</p>
        <h1 data-enter="2">{profile.positioning.statement}</h1>
        <p class="hero__lede" data-enter="3">
          {profile.positioning.detail}
        </p>
        <div class="hero__actions" data-enter="4">
          <Button href={routes.contact} size="lg">{copy.workWithMe}</Button>
          <Button href={routes.projects} variant="secondary" size="lg"
            >{copy.explore}</Button
          >
        </div>
        <p class="hero__opportunities" data-enter="4">
          {profile.positioning.opportunities}
        </p>
      </div>

      <figure class="hero-portrait" data-enter="3">
        <div class="hero-portrait__image">
          <img
            src="/images/roberto-villafuerte-portrait.jpeg"
            width="724"
            height="1086"
            alt="Roberto Villafuerte"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <figcaption>
          <span>Roberto Villafuerte</span>
          <span>{profile.headline}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="proof-strip" aria-labelledby="proof-heading">
    <div class="shell">
      <h2 id="proof-heading" class="sr-only">{copy.selectedEvidence}</h2>
      <ul class="proof-strip__grid" data-reveal>
        {
          profile.proof.map((item) => (
            <li class="proof-item">
              <span>{item.label}</span>
              <strong>{item.value}</strong>
              <small>{item.detail}</small>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="home-services" id="services">
    <div class="shell">
      <header class="section-heading section-heading--split" data-reveal>
        <div>
          <p class="eyebrow">{copy.servicesEyebrow}</p>
          <h2>{copy.servicesTitle}</h2>
        </div>
        <p>{copy.servicesDeck}</p>
      </header>

      <ol class="service-grid" data-reveal data-reveal-group>
        {
          profile.services.map((service, index) => (
            <li class="service-card">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{service.title}</h3>
              <p>{service.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="home-systems">
    <div class="shell">
      <header class="section-heading section-heading--split" data-reveal>
        <div>
          <p class="eyebrow">{copy.systemsEyebrow}</p>
          <h2>{copy.systemsTitle}</h2>
        </div>
        <p>{copy.systemsDeck}</p>
      </header>

      {
        flagshipSystem && (
          <article class="feature-case feature-case--home" data-reveal>
            <div class="feature-case__copy">
              <div class="feature-case__labels">
                <span class="evidence-chip">{copy.publicSource}</span>
                <span>{copy.flagship}</span>
              </div>
              <h3>
                {flagshipSystem.data.shortTitle || flagshipSystem.data.title}
              </h3>
              <p>{flagshipSystem.data.summary}</p>
              <dl class="system-record">
                <div>
                  <dt>{copy.boundary}</dt>
                  <dd>
                    {
                      systemRecords[
                        flagshipSystem.data.translationKey ??
                          flagshipSystem.data.slug
                      ].boundary
                    }
                  </dd>
                </div>
                <div>
                  <dt>{copy.decision}</dt>
                  <dd>
                    {
                      systemRecords[
                        flagshipSystem.data.translationKey ??
                          flagshipSystem.data.slug
                      ].decision
                    }
                  </dd>
                </div>
                <div>
                  <dt>{copy.evidence}</dt>
                  <dd>
                    {
                      systemRecords[
                        flagshipSystem.data.translationKey ??
                          flagshipSystem.data.slug
                      ].evidence
                    }
                  </dd>
                </div>
              </dl>
              <a
                class="text-link"
                href={`${routes.projects}/${flagshipSystem.data.translationKey ?? flagshipSystem.data.slug}`}
              >
                {copy.readCase} <span aria-hidden="true">↗</span>
              </a>
            </div>
            <div class="feature-case__signal boundary-flow">
              <p>{copy.flowEyebrow}</p>
              <ol class="boundary-flow__sequence" aria-label={copy.flowLabel}>
                {copy.flow.map((step, index) => (
                  <li>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <strong>{step.title}</strong>
                    <small>{step.detail}</small>
                  </li>
                ))}
              </ol>
              <small class="boundary-flow__legend">
                {copy.boundary} / {copy.decision} / {copy.evidence}
              </small>
            </div>
          </article>
        )
      }

      <div
        class="system-card-grid system-card-grid--supporting"
        data-reveal
        data-reveal-group
      >
        {
          supportingSystems.map((project, index) => (
            <a
              href={`${routes.projects}/${project.data.translationKey ?? project.data.slug}`}
              class="system-card"
            >
              <div class="system-card__meta">
                <span>
                  {copy.system} / {String(index + 2).padStart(2, '0')}
                </span>
                <span>{project.data.organization || project.data.role}</span>
              </div>
              <h3>{project.data.shortTitle || project.data.title}</h3>
              <p>{project.data.summary}</p>
              <dl class="system-card__record">
                <div>
                  <dt>{copy.decision}</dt>
                  <dd>
                    {
                      systemRecords[
                        project.data.translationKey ?? project.data.slug
                      ].decision
                    }
                  </dd>
                </div>
                <div>
                  <dt>{copy.evidence}</dt>
                  <dd>
                    {
                      systemRecords[
                        project.data.translationKey ?? project.data.slug
                      ].evidence
                    }
                  </dd>
                </div>
              </dl>
              <ul aria-label={copy.technologies}>
                {project.data.tags.slice(0, 3).map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <span class="system-card__link">
                {copy.readCase} <span aria-hidden="true">↗</span>
              </span>
            </a>
          ))
        }
      </div>

      <a class="all-work-link" href={routes.projects}>
        {copy.allWork}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="home-story">
    <div class="shell home-story__grid" data-reveal>
      <div>
        <p class="eyebrow">{copy.storyEyebrow}</p>
        <h2>{profile.story.title}</h2>
      </div>

      <div class="home-story__copy">
        {homeStoryParagraphs.map((paragraph) => <p>{paragraph}</p>)}

        <ol class="story-milestones">
          {
            homeStoryMilestones.map((milestone, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{milestone.place}</strong>
                <small>{milestone.detail}</small>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="home-principle">
    <div class="shell home-principle__grid" data-reveal>
      <p class="eyebrow">{copy.pointOfView}</p>
      <h2>{profile.pointOfView.statement}</h2>
      <p>{profile.pointOfView.detail}</p>
    </div>
  </section>

  <section class="home-close">
    <div class="shell home-close__grid" data-reveal>
      <p class="eyebrow">{copy.closeEyebrow}</p>
      <h2>{copy.closeTitle}</h2>
      <div>
        <p>{copy.closeDeck}</p>
        <Button href={routes.contact} variant="secondary"
          >{copy.workWithMe}</Button
        >
      </div>
    </div>
  </section>
</BaseLayout>
