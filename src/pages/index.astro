---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import projects from '../data/projects.json';

const featuredProjects = projects.projects
  .filter((p) => p.featured)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

const proofCards = [
  {
    title: 'What I Build',
    description: 'Secure data platforms — scalable schemas, multi-tenant architectures, ETL pipelines, and privacy-aware analytics foundations. I design data systems that handle sensitive information responsibly and deliver measurable insights.',
  },
  {
    title: 'How I Work',
    description: 'Governance first. I start with privacy requirements and data quality constraints, then design for auditability, access control, and observability. Every system I build has clear data lineage and a path to iterate safely.',
  },
  {
    title: 'What I Care About',
    description: 'Privacy and integrity over speed. I\'d rather build a well-governed, auditable data foundation than rush a system that leaks trust. The goal is data you can act on — reliably and responsibly.',
  },
];
---

<BaseLayout
  title="Roberto Villafuerte | Data Architect | Privacy & Data Governance | HealthTech"
  description="Data Architect building privacy-first, governance-driven data systems for HealthTech and analytics products. Data modeling, secure pipelines, and actionable insights from sensitive data."
>
  <!-- Hero -->
  <section class="py-20 sm:py-32">
    <div class="container-narrow">
      <h1 class="text-4xl sm:text-5xl font-semibold text-gray-900 mb-6">
        I build privacy-first data systems for health and analytics.
      </h1>
      <p class="text-xl text-gray-600 mb-8 max-w-2xl">
        Data Architect focused on data modeling, governance, secure data handling, and scalable ETL pipelines. I turn sensitive health signals into actionable insights — without compromising privacy or trust.
      </p>
      <div class="flex flex-wrap gap-4">
        <Button href="/projects" size="lg">View Projects</Button>
        <Button href="/contact" variant="secondary" size="lg">Get in Touch</Button>
      </div>
    </div>
  </section>

  <!-- Proof Row -->
  <Section class="bg-white border-y border-gray-200">
    <h2 class="sr-only">What I Do</h2>
    <div class="grid md:grid-cols-3 gap-8">
      {proofCards.map((card) => (
        <div>
          <h3 class="font-semibold text-gray-900 mb-3">{card.title}</h3>
          <p class="text-gray-600 text-sm leading-relaxed">{card.description}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Featured Projects -->
  <Section title="Featured Projects">
    <div class="grid gap-6">
      {featuredProjects.map((project) => (
        <Card
          title={project.title}
          summary={project.summary}
          href={`/projects/${project.slug}`}
          tags={project.tags}
          date={project.date}
          variant="featured"
        />
      ))}
    </div>
    <div class="mt-8">
      <Button href="/projects" variant="ghost">
        View all projects
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </Button>
    </div>
  </Section>

  <!-- CTA -->
  <Section class="bg-white border-y border-gray-200">
    <div class="text-center">
      <h2 class="text-2xl font-semibold mb-4">Interested in working together?</h2>
      <p class="text-gray-600 mb-6">
        Currently building data infrastructure for HealthTech — open to data architecture, governance, and engineering opportunities.
      </p>
      <Button href="/contact">Get in Touch</Button>
    </div>
  </Section>
</BaseLayout>
