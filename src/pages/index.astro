---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { getCollection } from 'astro:content';
import { links } from '../data/links';
import { localeRoutes, type Locale } from '../i18n';
import '../styles/home-renewal.css';
interface Props {
  locale?: Locale;
}
const { locale = 'es' } = Astro.props;
const routes = localeRoutes[locale];
const es = locale === 'es';
const copy = es
  ? {
      title: 'Soy Roberto.',
      lead: 'Construyo con IA y comparto lo que aprendo.',
      intro:
        'Me estoy formando como AI Engineer para crear tecnología y fundar empresas desde Latinoamérica con alcance global.',
      work: 'Ver mis proyectos',
      about: 'Conocer mi historia',
      current: 'Lo que estoy construyendo.',
      currentText:
        'Una aplicación propia, sistemas que he construido y preguntas que sigo explorando. Cada proyecto cuenta sus decisiones y sus límites.',
      all: 'Ver todos los proyectos',
      read: 'Leer el proyecto',
      practice: 'Aprender también es probar.',
      practiceText:
        'Me interesa entender cómo funcionan las cosas y llevarlas a un proyecto. Aquí comparto el proceso: el problema, las decisiones y lo que falta por resolver.',
      steps: [
        {
          title: 'Partir de un problema concreto',
          text: 'Qué necesita hacer el sistema, para quién y con qué datos. Antes de elegir el modelo, aclarar la pregunta.',
        },
        {
          title: 'Construir algo que se pueda revisar',
          text: 'Conectar datos, modelos y software. Documentar las decisiones para que el resultado no dependa de una demostración aislada.',
        },
        {
          title: 'Comprobar y contar lo aprendido',
          text: 'Mirar las pruebas y los límites junto al resultado. Compartir una conclusión que pueda sostener con el trabajo realizado.',
        },
      ],
      life: 'Fuera de la pantalla.',
      lifeText:
        'La curiosidad también me lleva a otros lugares. Bailo salsa, aprendo chino y me gusta conocer culturas distintas.',
      salsa:
        'Empecé salsa para salir de mi zona de confort. Se convirtió en uno de mis hobbies favoritos.',
      travel: 'Viajar y conocer otras formas de vivir.',
      story: 'Más sobre mí',
      note: 'Construir tecnología es una parte de mi vida. Hay más historias en el camino.',
      talk: 'Sigamos conversando.',
      talkText:
        'Si compartimos una pregunta, una idea o las ganas de construir algo, me gustará leerte.',
      contact: 'Escríbeme',
    }
  : {
      title: 'I’m Roberto.',
      lead: 'I build with AI and share what I learn.',
      intro:
        'I’m training as an AI Engineer to build technology and start companies from Latin America with a global reach.',
      work: 'See my projects',
      about: 'Read my story',
      current: 'What I’m building.',
      currentText:
        'An app of my own, systems I’ve built, and questions I’m still exploring. Each project explains its decisions and limitations.',
      all: 'See all projects',
      read: 'Read the project',
      practice: 'Learning means trying things.',
      practiceText:
        'I want to understand how things work and turn that understanding into projects. I share the process: the problem, the decisions, and what remains unresolved.',
      steps: [
        {
          title: 'Start with a concrete problem',
          text: 'What the system needs to do, for whom, and with what data. Clarify the question before choosing a model.',
        },
        {
          title: 'Build something others can inspect',
          text: 'Connect data, models, and software. Document decisions so the result goes beyond an isolated demonstration.',
        },
        {
          title: 'Check and share what I learn',
          text: 'Read the tests and limitations alongside the result. Share conclusions supported by the work itself.',
        },
      ],
      life: 'Away from the screen.',
      lifeText:
        'Curiosity takes me other places, too. I dance salsa, learn Chinese, and enjoy getting to know different cultures.',
      salsa:
        'I started salsa to leave my comfort zone. It became one of my favorite hobbies.',
      travel: 'Traveling and discovering other ways of living.',
      story: 'More about me',
      note: 'Building technology is one part of my life. There are more stories along the way.',
      talk: 'Let’s keep talking.',
      talkText:
        'If we share a question, an idea, or the desire to build something, I’d like to hear from you.',
      contact: 'Get in touch',
    };
const workCopy: Record<string, { title: string; summary: string }> = es
  ? {
      panorama: {
        title: 'Panorama',
        summary:
          'Una app propia para registrar gastos y entender mejor los movimientos del día a día.',
      },
      'fairness-aware-candidate-pre-screening': {
        title: 'Equidad en machine learning',
        summary:
          'Un laboratorio público para revisar datos, políticas y límites de una evaluación.',
      },
      'compumax-rag-pipeline': {
        title: 'IA para soporte',
        summary:
          'Recuperación de información, servicios y escalamiento a una persona en un mismo sistema.',
      },
    }
  : {
      panorama: {
        title: 'Panorama',
        summary:
          'My own app for recording expenses and making everyday transactions easier to understand.',
      },
      'fairness-aware-candidate-pre-screening': {
        title: 'Fairness in machine learning',
        summary:
          'A public lab for inspecting data, policies, and the limits of an evaluation.',
      },
      'compumax-rag-pipeline': {
        title: 'AI for support',
        summary:
          'Information retrieval, services, and human escalation connected in one system.',
      },
    };
const order = [
  'panorama',
  'fairness-aware-candidate-pre-screening',
  'compumax-rag-pipeline',
];
const collection = await getCollection(
  'projects',
  ({ data }) => data.locale === locale && data.evidence !== 'hold',
);
const projects = order.flatMap((key) => {
  const entry = collection.find(
    ({ data }) => (data.translationKey ?? data.slug) === key,
  );
  return entry ? [{ entry, key, ...workCopy[key] }] : [];
});
---

<BaseLayout
  title="Roberto Villafuerte"
  description={`${copy.lead} ${copy.intro}`}
  locale={locale}
>
  <section class="hello shell" aria-labelledby="hello-title">
    <div class="hello__words">
      <h1 id="hello-title">{copy.title}</h1>
      <p class="hello__lead">{copy.lead}</p><p class="hello__intro">
        {copy.intro}
      </p>
      <div class="hello__actions">
        <a class="renewal-button" href="#proyectos"
          >{copy.work}<ArrowIcon direction="right" /></a
        >
        <a class="renewal-link" href={routes.about}>{copy.about}<ArrowIcon /></a
        >
      </div>
    </div>
    <figure class="hello__photo">
      <img
        src="/images/renewal/portrait.webp"
        width="640"
        height="961"
        alt="Roberto Villafuerte"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </section>
  <section class="building" id="proyectos" aria-labelledby="building-title">
    <div class="shell building__layout">
      <header>
        <h2 id="building-title">{copy.current}</h2><p>{copy.currentText}</p><a
          class="renewal-link"
          href={routes.projects}>{copy.all}<ArrowIcon direction="right" /></a
        >
      </header>
      <div class="building__projects">
        {
          projects.map((project) => (
            <article>
              <a
                href={`${routes.projects}${project.key}/`}
                class="building__project"
              >
                <>
                  <div>
                    <>
                      <h3>{project.title}</h3>
                      <p>{project.summary}</p>
                      <span class="building__read">{copy.read}</span>
                    </>
                  </div>
                  <ArrowIcon />
                </>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="learning shell" aria-labelledby="learning-title">
    <figure class="learning__photo">
      <img
        src="/images/renewal/coding.webp"
        width="1200"
        height="675"
        alt={es
          ? 'Una sesión de programación en mi portátil'
          : 'A programming session on my laptop'}
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="learning__copy">
      <h2 id="learning-title">{copy.practice}</h2><p>{copy.practiceText}</p>
      <div class="learning__questions">
        {
          copy.steps.map((step) => (
            <details name="learning">
              <>
                <summary>
                  {step.title}
                  <span class="details-indicator" aria-hidden="true" />
                </summary>
                <p>{step.text}</p>
              </>
            </details>
          ))
        }
      </div>
    </div>
  </section>
  <section class="elsewhere" aria-labelledby="elsewhere-title">
    <div class="shell">
      <header class="elsewhere__heading">
        <h2 id="elsewhere-title">{copy.life}</h2><p>{copy.lifeText}</p>
      </header>
      <div class="elsewhere__layout">
        <figure class="elsewhere__travel">
          <img
            src="/images/renewal/travel.webp"
            width="960"
            height="1280"
            alt={es
              ? 'Roberto junto a una cabina telefónica roja en Londres'
              : 'Roberto beside a red telephone box in London'}
            loading="lazy"
            decoding="async"
          /><figcaption>{copy.travel}</figcaption>
        </figure>
        <figure class="elsewhere__salsa">
          <img
            src="/images/renewal/salsa.webp"
            width="675"
            height="1200"
            alt={es
              ? 'Una noche de salsa con música en vivo'
              : 'A salsa night with live music'}
            loading="lazy"
            decoding="async"
          /><figcaption>{copy.salsa}</figcaption>
        </figure>
        <div class="elsewhere__note">
          <p>{copy.note}</p><a class="renewal-link" href={routes.about}
            >{copy.story}<ArrowIcon direction="right" /></a
          >
        </div>
      </div>
    </div>
  </section>
  <section class="say-hello shell" aria-labelledby="talk-title">
    <h2 id="talk-title">{copy.talk}</h2><div>
      <p>{copy.talkText}</p><a class="renewal-button" href={links.email}
        >{copy.contact}<ArrowIcon /></a
      >
    </div>
  </section>
</BaseLayout>
