---
import PilotSecurity from '../components/PilotSecurity.astro';
import PilotLayout from '../layouts/PilotLayout.astro';
import {
  pilot,
  budgets,
  availabilitySlots,
  roles,
  goals,
  toolOptions,
  countrySuggestions,
} from '../data/pilot';
---

<PilotLayout>
  <section class="hero pilot-shell" aria-labelledby="pilot-title">
    <div class="hero-copy">
      <p class="eyebrow">5 personas · Una sesión individual gratis</p>
      <h1 id="pilot-title">Tu segundo cerebro.<br /><em>Hecho contigo.</em></h1>
      <p class="pilot-intro">
        Vamos a integrar la IA a tu forma de trabajar,{' '}
        <strong>con tu información y tus proyectos.</strong>
      </p>
      <p class="hero-note">
        El{' '}<strong>15 y 16 de octubre</strong>{' '}trabajaré uno a uno con
        cinco personas. Te llevarás tu segundo cerebro para organizar y usar tus
        notas, documentos y decisiones con IA, y una guía para seguir haciéndolo
        crecer.
      </p>
      <a class="pilot-button" href="#aplicar"
        >Quiero aplicar <span aria-hidden="true">↗</span></a
      >
      <p class="small">
        Inscríbete hasta el martes 13 de octubre.<br />Sin crear una cuenta. Sin
        pagos. Si eres estudiante, también puedes participar.
      </p>
      <div class="host">
        <img src="/brand/clover.svg" width="28" height="28" alt="" />
        <p>
          <strong>Roberto Villafuerte · AI Engineer</strong><br />Villa for Tech
        </p>
      </div>
    </div>
    <aside class="session-card" aria-label="Tu sesión, en pocas palabras">
      <p class="eyebrow">De información dispersa a contexto útil</p>
      <p class="card-title">
        Tus proyectos.<br />Tus herramientas.<br /><em>Tu propio sistema.</em>
      </p>
      <ul>
        <li>
          <span aria-hidden="true">01</span><p>
            <strong>Construimos tu segundo cerebro.</strong><br />Notas,
            documentos, decisiones y próximos pasos.
          </p>
        </li>
        <li>
          <span aria-hidden="true">02</span><p>
            <strong>Lo ponemos a trabajar con IA.</strong><br />Probamos una
            tarea real con tus fuentes.
          </p>
        </li>
        <li>
          <span aria-hidden="true">03</span><p>
            <strong>Te llevas una guía para seguir.</strong><br />Cómo
            actualizarlo y hacerlo crecer con tus proyectos.
          </p>
        </li>
      </ul>
      <p class="card-foot">15–16 OCT <span>1 A 1 · GRATIS</span></p>
    </aside>
  </section>

  <section
    class="application pilot-shell"
    id="aplicar"
    aria-labelledby="apply-title"
  >
    <aside class="application-intro" aria-label="Fechas y confirmación">
      <p class="eyebrow">Inscripción rápida</p>
      <h2 id="apply-title">Vamos a trabajar<br /><em>con lo tuyo.</em></h2>
      <p>
        Completa tus datos, marca tus opciones y envía tu aplicación. Elegiré
        cinco casos que podamos trabajar juntos.
      </p>
      <dl class="dates">
        <div><dt>Sesiones</dt><dd>Jueves 15 o viernes 16 de octubre</dd></div>
        <div><dt>Inscripciones hasta</dt><dd>{pilot.closesLabel}</dd></div>
        <div>
          <dt>Confirmación de los cinco cupos</dt><dd>
            Miércoles 14, por correo
          </dd>
        </div>
      </dl>
      <p class="small">
        Elegiré cinco casos que podamos trabajar en una sesión. Inscribirte no
        reserva automáticamente un cupo.
      </p>
    </aside>
    <div class="form-panel">
      <div id="closed-message" class="notice" hidden>
        <h3>Las inscripciones cerraron.</h3>
        <p>
          Gracias por tu interés. Puedes escribirme a <a
            href={`mailto:${pilot.contact}`}>{pilot.contact}</a
          >.
        </p>
      </div>
      <p class="form-guide">
        5 cupos gratis · 15 o 16 de octubre · Cierre: martes 13
      </p>
      <p class="form-promise">
        Tu segundo cerebro y una guía para seguir haciéndolo crecer.
      </p>
      <p class="hint form-instructions">
        Solo escribe tus datos de contacto; el resto se elige. Los campos
        opcionales están indicados.
      </p>
      <form
        id="pilot-form"
        action="/api/segundo-cerebro"
        method="post"
        autocomplete="on"
        data-closes-at={pilot.closesAt}
      >
        <div class="field-grid">
          <div class="field">
            <label for="name">¿Cómo te llamas?</label>
            <input
              type="text"
              id="name"
              name="name"
              autocomplete="name"
              autocapitalize="words"
              enterkeyhint="next"
              minlength="2"
              maxlength="100"
              placeholder="Tu nombre"
              required
            />
          </div>
          <div class="field">
            <label for="email">Tu correo</label>
            <input
              type="email"
              id="email"
              name="email"
              autocomplete="email"
              inputmode="email"
              spellcheck="false"
              enterkeyhint="next"
              maxlength="254"
              placeholder="nombre@correo.com"
              required
            />
          </div>
        </div>
        <div class="field-grid">
          <div class="field">
            <label for="whatsapp">WhatsApp (opcional)</label>
            <input
              type="tel"
              id="whatsapp"
              name="whatsapp"
              autocomplete="tel"
              inputmode="tel"
              enterkeyhint="next"
              maxlength="40"
              placeholder="Incluye el código de país"
              aria-describedby="whatsapp-hint"
            />
            <p class="hint" id="whatsapp-hint">
              Con código de país, si quieres coordinar por WhatsApp.
            </p>
          </div>
          <div class="field">
            <label for="country">País (opcional)</label>
            <input
              type="text"
              id="country"
              name="country"
              autocomplete="country-name"
              list="country-options"
              maxlength="80"
              placeholder="Elige o escribe tu país"
            />
            <datalist id="country-options">
              {countrySuggestions.map((country) => <option value={country} />)}
            </datalist>
            <p class="hint">Para coordinar desde dónde participas.</p>
          </div>
        </div>
        <div class="field">
          <label for="role">¿A qué te dedicas?</label>
          <select id="role" name="role" required>
            <option value="" selected disabled
              >Elige el área que más se acerque</option
            >
            {
              roles.map((role) => (
                <option value={role.value}>{role.label}</option>
              ))
            }
          </select>
        </div>
        <div class="field">
          <label for="goal">¿Para qué quieres usar tu segundo cerebro?</label>
          <select id="goal" name="goal" required>
            <option value="" selected disabled>Elige tu prioridad</option>
            {
              goals.map((goal) => (
                <option value={goal.value}>{goal.label}</option>
              ))
            }
          </select>
        </div>
        <fieldset class="choice-field" aria-describedby="tools-hint">
          <legend>¿Dónde está tu información y qué herramientas usas?</legend>
          <p class="hint" id="tools-hint">Marca todas las que correspondan.</p>
          <div class="tools-options">
            {
              toolOptions.map((tool) => (
                <label class="choice">
                  <input type="checkbox" name="tools[]" value={tool.value} />
                  <span>{tool.label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <fieldset class="choice-field" aria-describedby="budget-hint">
          <legend
            >¿Qué presupuesto mensual tienes para herramientas de IA?</legend
          >
          <div class="budget-options">
            {
              budgets.map((budget) => (
                <label class="choice">
                  <>
                    <input
                      type="radio"
                      name="budget"
                      value={budget.value}
                      required
                    />
                    <span>{budget.label}</span>
                  </>
                </label>
              ))
            }
          </div>
          <p class="hint" id="budget-hint">
            En dólares (USD). $0 también está bien: la sesión es gratis y no
            necesitas comprar herramientas para participar.
          </p>
        </fieldset>
        <fieldset class="choice-field" aria-describedby="availability-hint">
          <legend>¿Cuándo podrías asistir?</legend>
          <p class="hint" id="availability-hint">
            Marca todas las franjas que te sirven. Hora de Ecuador continental
            (UTC−5).
          </p>
          <div class="slot-days">
            {
              ['Jueves 15', 'Viernes 16'].map((day) => (
                <div class="slot-day">
                  <>
                    <p>{day} de octubre</p>
                    <div class="slot-options">
                      {availabilitySlots
                        .filter((slot) => slot.day === day)
                        .map((slot) => (
                          <label class="choice">
                            <input
                              type="checkbox"
                              name="availability[]"
                              value={slot.value}
                              aria-label={`${slot.day}: ${slot.label}`}
                            />
                            <span>{slot.label}</span>
                          </label>
                        ))}
                    </div>
                  </>
                </div>
              ))
            }
          </div>
          <p class="hint">
            Son preferencias de horario; el miércoles confirmaremos la hora
            exacta por correo.
          </p>
        </fieldset>
        <div class="field">
          <label for="project"
            >¿Qué proyecto te gustaría trabajar? (opcional)</label
          >
          <input
            type="text"
            id="project"
            name="project"
            maxlength="250"
            placeholder="Una frase, si quieres contarme algo más"
          />
          <p class="hint">
            Puedes aclarar tu área o herramientas aquí. No incluyas información
            confidencial.
          </p>
        </div>
        <label class="consent"
          ><input type="checkbox" name="consent" value="yes" required /><span
            >Autorizo usar mis respuestas para esta inscripción y contactarme
            sobre la sesión. <a href="#privacidad">Uso de datos</a>.</span
          ></label
        >
        <input type="hidden" name="source" id="source" value="direct" />
        <div class="honeypot" aria-hidden="true">
          <label for="website">Deja este campo vacío</label><input
            type="text"
            id="website"
            name="website"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <PilotSecurity action="pilot_apply" />
        <p id="form-status" role="status" tabindex="-1"></p>
        <button class="pilot-button" id="submit-button" type="submit"
          >Enviar mi aplicación <span aria-hidden="true">↗</span></button
        >
        <p class="small">
          Tu aplicación estará enviada cuando veas la confirmación. Te escribiré
          el miércoles 14 si tu caso es seleccionado. Sin publicidad.
        </p>
      </form>
      <section
        id="success-message"
        class="notice"
        tabindex="-1"
        hidden
        aria-labelledby="success-title"
      >
        <p class="eyebrow">Aplicación recibida</p>
        <h2 id="success-title">Ya recibí tus respuestas.</h2>
        <p id="success-detail"></p>
        <p class="small">
          Para corregir tus datos, escribe a <a href={`mailto:${pilot.contact}`}
            >{pilot.contact}</a
          > desde el correo que usaste.
        </p>
      </section>
    </div>
  </section>

  <section class="details pilot-shell" aria-labelledby="details-title">
    <p class="eyebrow">Lo que necesitas para empezar</p>
    <h2 id="details-title">
      Tu información.<br /><em>Un segundo cerebro que puedas usar.</em>
    </h2>
    <div class="detail-grid">
      <div>
        <h3>Trae lo que ya tienes.</h3><p>
          Si confirmamos tu cupo, prepararemos 2–5 notas o documentos breves que
          tengas permiso de usar. No necesitas programar.
        </p>
      </div>
      <div>
        <h3>Lo construimos juntos.</h3><p>
          Organizamos tu contexto, probamos una consulta con IA y te llevas
          instrucciones para actualizar tu espacio.
        </p>
      </div>
      <div>
        <h3>Empieza sin comprar nada.</h3><p>
          Usaremos las herramientas disponibles para tu caso. El presupuesto nos
          ayuda a adaptar las opciones; no decide quién obtiene un cupo.
        </p>
      </div>
    </div>
    <p class="small">
      Si eres técnico, podemos incluir documentación, decisiones técnicas y
      código de tu proyecto. Si eres estudiante, también puedes participar.
      Construiremos una estructura que puedas mantener; las migraciones
      completas y el desarrollo de software a medida quedan fuera de esta
      sesión.
    </p>
  </section>
  <section
    class="privacy pilot-shell"
    id="privacidad"
    aria-labelledby="privacy-title"
  >
    <h2 id="privacy-title">Tus respuestas son privadas.</h2>
    <p>
      Roberto Villafuerte usará tus datos, preferencias y el origen del enlace
      para organizar esta convocatoria y coordinar las cinco sesiones. Se
      guardan de forma privada en la infraestructura de esta web, alojada en
      Vercel. No se usarán como testimonios ni para enviarte publicidad.
    </p>
    <p>
      Usamos Cloudflare Turnstile para detectar envíos automatizados y proteger
      el formulario.
    </p>
    <p>
      Puedes pedir corregir o eliminar tu inscripción en <a
        href={`mailto:${pilot.contact}`}>{pilot.contact}</a
      >. Cualquier uso público de tu caso se autorizará por separado.
    </p>
  </section>
</PilotLayout>

<script>
  import { sources } from '../data/pilot';
  import { mountPilotSecurity } from '../scripts/pilot-security';
  const form = document.querySelector<HTMLFormElement>('#pilot-form');
  const submit = document.querySelector<HTMLButtonElement>('#submit-button');
  const status = document.querySelector<HTMLParagraphElement>('#form-status');
  const success = document.querySelector<HTMLElement>('#success-message');
  if (form && submit && status && success) {
    const security = mountPilotSecurity(form);
    const source = new URLSearchParams(location.search).get('utm_source');
    const sourceField = form.querySelector<HTMLInputElement>('#source');
    if (sourceField && sources.some((known) => known === source))
      sourceField.value = source!;
    const slots = Array.from(
      form.querySelectorAll<HTMLInputElement>('[name="availability[]"]'),
    );
    const validateSlots = () =>
      slots[0]?.setCustomValidity(
        slots.some((slot) => slot.checked)
          ? ''
          : 'Marca al menos una franja para el 15 o 16 de octubre.',
      );
    slots.forEach((slot) => slot.addEventListener('change', validateSlots));
    validateSlots();
    const tools = Array.from(
      form.querySelectorAll<HTMLInputElement>('[name="tools[]"]'),
    );
    const validateTools = () =>
      tools[0]?.setCustomValidity(
        tools.some((tool) => tool.checked)
          ? ''
          : 'Marca una herramienta o «Aún no tengo un sistema».',
      );
    tools.forEach((tool) => tool.addEventListener('change', validateTools));
    validateTools();
    const closeIfNeeded = () => {
      if (Date.now() < Date.parse(form.dataset.closesAt ?? '')) return false;
      form.hidden = true;
      document.querySelector<HTMLElement>('#closed-message')!.hidden = false;
      return true;
    };
    closeIfNeeded();
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submit.disabled || closeIfNeeded()) return;
      validateSlots();
      validateTools();
      if (!form.reportValidity()) return;
      submit.disabled = true;
      submit.textContent = 'Comprobando el envío…';
      status.textContent = '';
      try {
        const token = await security.getToken();
        submit.textContent = 'Enviando tu aplicación…';
        const body = new URLSearchParams();
        for (const [key, value] of new FormData(form))
          body.append(key, String(value));
        body.set('cf-turnstile-response', token);
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body,
        });
        if (response.status === 429)
          throw new Error(
            'Hay demasiados intentos seguidos. Espera un minuto y vuelve a enviar; tus respuestas siguen aquí.',
          );
        if (!response.headers.get('content-type')?.includes('application/json'))
          throw new Error(
            'No pudimos confirmar el envío. Espera un momento y vuelve a intentarlo; tus respuestas siguen aquí.',
          );
        const result = await response.json();
        if (!response.ok || result.ok !== true)
          throw new Error(
            result.message ||
              'No pudimos guardar tu inscripción. Inténtalo de nuevo.',
          );
        document.querySelector('#success-detail')!.textContent = result.message;
        form.hidden = true;
        success.hidden = false;
        success.focus();
      } catch (error) {
        security.reset();
        status.textContent =
          error instanceof Error && !error.message.startsWith('Unexpected')
            ? error.message
            : 'No pudimos confirmar el envío. Tus respuestas siguen aquí; comprueba tu conexión e inténtalo de nuevo.';
        status.focus();
        submit.disabled = false;
        submit.textContent = 'Volver a enviar mi aplicación';
      }
    });
  }
</script>

<style>
  :global(html) {
    scroll-padding-top: 24px;
    scroll-behavior: auto;
  }
  .pilot-shell {
    width: min(calc(100% - 48px), 1120px);
    margin-inline: auto;
  }
  .hero {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 70px;
    align-items: center;
    padding-block: 64px;
  }
  h1 {
    font: 400 clamp(3.5rem, 5.5vw, 5.15rem)/1.02 var(--font-display);
    letter-spacing: -0.035em;
    margin-top: 20px;
  }
  h1 em,
  h2 em {
    color: var(--leaf);
  }
  h2 {
    font: 400 clamp(2.4rem, 3.5vw, 3.3rem)/1.08 var(--font-display);
    letter-spacing: -0.02em;
  }
  .pilot-intro {
    font-size: 1.12rem;
    margin-top: 24px;
    max-width: 48ch;
  }
  .hero-note {
    margin: 18px 0 26px;
    max-width: 51ch;
    font-size: 0.95rem;
  }
  .pilot-button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 16px 22px;
    background: var(--forest);
    color: var(--paper);
    border: 1px solid var(--forest);
    font-weight: 650;
    text-decoration: none;
    font-size: 1rem;
    line-height: 1.4;
    cursor: pointer;
  }
  .pilot-button:hover {
    background: var(--leaf);
  }
  .pilot-button:disabled {
    opacity: 0.65;
    cursor: wait;
  }
  .small {
    font-size: 0.78rem;
    color: var(--leaf);
    line-height: 1.65;
    margin-top: 14px;
  }
  .host {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
  }
  .host img {
    flex: 0 0 auto;
  }
  .session-card {
    padding: 32px;
    background: var(--forest);
    color: var(--paper);
  }
  .session-card .eyebrow {
    color: var(--sage);
    font-size: 0.64rem;
  }
  .card-title {
    font: 400 clamp(2rem, 3.3vw, 3rem)/1.07 var(--font-display);
    margin-top: 20px;
  }
  .card-title em {
    color: var(--sage);
  }
  .session-card ul {
    list-style: none;
    padding: 0;
    margin-top: 30px;
  }
  .session-card li {
    display: flex;
    gap: 15px;
    border-top: 1px solid var(--line-inverse);
    padding-block: 17px;
    font-size: 0.8rem;
  }
  .session-card li > span {
    font-size: 0.65rem;
    color: var(--sage);
    padding-top: 3px;
  }
  .card-foot {
    border-top: 1px solid var(--line-inverse);
    padding-top: 17px;
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 0.69rem;
    font-weight: 700;
  }
  .application {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: 60px;
    align-items: start;
    padding-block: 54px 64px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 20px;
  }
  .application-intro h2 {
    margin-top: 14px;
  }
  .application-intro > p:not(.eyebrow) {
    margin-top: 20px;
  }
  .dates {
    margin-top: 28px;
  }
  .dates > div {
    border-top: 1px solid var(--line);
    padding-block: 14px;
  }
  dt {
    color: var(--leaf);
    font-size: 0.74rem;
  }
  dd {
    font-weight: 650;
    font-size: 0.83rem;
    margin-top: 4px;
  }
  .form-panel {
    min-width: 0;
    padding: 28px;
    background: #fffdf7;
    border: 1px solid var(--line);
  }
  .form-guide {
    font-size: 0.76rem;
    font-weight: 650;
    margin-bottom: 8px;
    color: var(--leaf);
  }
  .form-instructions {
    margin-bottom: 22px;
  }
  .form-promise {
    font-size: 1rem;
    font-weight: 650;
  }
  .field-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .field {
    margin-bottom: 20px;
  }
  .field label,
  legend {
    display: block;
    font-weight: 650;
    font-size: 0.86rem;
    margin-bottom: 8px;
  }
  input[type='text'],
  input[type='email'],
  input[type='tel'],
  select {
    width: 100%;
    min-width: 0;
    min-height: 48px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--white);
    color: var(--forest);
    font-size: 1rem;
  }
  select {
    font-family: inherit;
    padding-right: 26px;
    text-overflow: ellipsis;
  }
  input::placeholder {
    color: #66706b;
    font-size: 0.86rem;
  }
  fieldset {
    padding: 0;
    margin: 0 0 22px;
    border: 0;
    min-width: 0;
  }
  legend {
    padding: 0;
  }
  .hint {
    color: var(--leaf);
    font-size: 0.74rem;
    line-height: 1.6;
    margin-top: 8px;
  }
  .budget-options,
  .slot-options {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }
  .tools-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7px;
    margin-top: 12px;
  }
  .choice {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 46px;
    padding: 10px 11px;
    border: 1px solid var(--line);
    font-size: 0.79rem;
    cursor: pointer;
  }
  .choice:has(input:checked) {
    background: var(--sage);
    border-color: var(--forest);
  }
  .choice:focus-within {
    outline: 2px solid var(--clay);
    outline-offset: 2px;
  }
  .choice input {
    flex-shrink: 0;
