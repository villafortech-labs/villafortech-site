---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { localeFromPath, localeRoutes } from '../i18n';

const locale = localeFromPath(Astro.url.pathname);
const routes = localeRoutes[locale];
const copy = {
  en: {
    title: 'Page not found',
    description: 'The requested page could not be found.',
    eyebrow: 'Page not found',
    heading: 'Let’s take another path.',
    detail: 'The page may have moved, or the address may be incomplete.',
    action: 'Return home',
  },
  es: {
    title: 'Página no encontrada',
    description: 'No se encontró la página solicitada.',
    eyebrow: 'Página no encontrada',
    heading: 'Tomemos otro camino.',
    detail: 'La página puede haberse movido o la dirección está incompleta.',
    action: 'Volver al inicio',
  },
}[locale];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  noIndex={true}
  locale={locale}
>
  <section class="not-found">
    <div class="shell not-found__grid">
      <p class="not-found__code">404</p>
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.heading}</h1>
        <p>{copy.detail}</p>
        <Button href={routes.home}>{copy.action}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
