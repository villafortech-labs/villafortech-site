---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { socialProfiles } from '../data/links';
import { localeRoutes, sharedCopy, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'es' } = Astro.props;
const routes = localeRoutes[locale];
const copy = {
  es: {
    title: 'Proyectos y redes',
    description:
      'Encuentra los proyectos, el código, los videos y las redes de Roberto Villafuerte y Villa for Tech.',
    intro: 'Elige por dónde seguir.',
    projects: 'Ver los proyectos',
    projectsDetail: 'Qué construí, cómo funciona y lo que aprendí.',
    profiles: 'Encuéntrame en',
    navigation: 'Redes y código de Roberto Villafuerte',
    contact: 'Escríbeme',
    contactDetail: 'Para una pregunta o una conversación más larga.',
  },
  en: {
    title: 'Projects and links',
    description:
      'Find Roberto Villafuerte’s projects, code, videos, and Villa for Tech profiles.',
    intro: 'Choose where to go next.',
    projects: 'See the projects',
    projectsDetail: 'What I built, how it works, and what I learned.',
    profiles: 'Find me on',
    navigation: 'Roberto Villafuerte’s profiles and code',
    contact: 'Write to me',
    contactDetail: 'For a question or a longer conversation.',
  },
}[locale];
const destinations = socialProfiles.filter(
  (social) => social.name !== 'Instagram',
);
---

<BaseLayout title={copy.title} description={copy.description} locale={locale}>
  <section class="link-directory shell" aria-labelledby="links-title">
    <header class="link-directory__heading">
      <h1 id="links-title">{copy.title}</h1>
      <p>{copy.intro}</p>
    </header>

    <a class="project-entry" href={routes.projects}>
      <span>
        <strong>{copy.projects}</strong>
        <span>{copy.projectsDetail}</span>
      </span>
      <ArrowIcon direction="right" />
    </a>

    <div class="link-directory__networks">
      <h2>{copy.profiles}</h2>
      <nav aria-label={copy.navigation}>
        <ul class="network-list">
          {
            destinations.map((destination) => (
              <li>
                <a
                  class="network-link"
                  href={destination.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>
                    <strong>{destination.name}</strong>
                    <span>{destination.description[locale]}</span>
                  </span>
                  <ArrowIcon direction="diagonal" />
                  <span class="sr-only">{sharedCopy[locale].newTab}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <a class="directory-contact" href={routes.contact}>
      <span>
        <strong>{copy.contact}</strong>
        <span>{copy.contactDetail}</span>
      </span>
      <ArrowIcon direction="right" />
    </a>
  </section>
</BaseLayout>

<style>
  .link-directory {
    max-width: 880px;
    padding-block: clamp(3rem, 7vw, 6rem) 5rem;
  }
  .link-directory__heading {
    margin-bottom: 2.5rem;
  }
  .link-directory__heading h1 {
    max-width: 12ch;
    font: 650 clamp(2.7rem, 7vw, 4.6rem) / 1.05 var(--font-display);
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .link-directory__heading p {
    margin-top: 1rem;
    font-size: 1.125rem;
    color: var(--leaf);
  }
  .project-entry,
  .directory-contact,
  .network-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    text-decoration: none;
  }
  .project-entry {
    min-height: 150px;
    padding: 2rem;
    border-radius: 16px;
    background: var(--forest);
    color: var(--paper);
    transition: background-color 180ms ease;
  }
  .project-entry strong {
    display: block;
    font-size: clamp(1.5rem, 4vw, 2rem);
    letter-spacing: -0.03em;
  }
  .project-entry span > span {
    display: block;
    margin-top: 0.65rem;
    color: var(--sage);
    line-height: 1.5;
  }
  .project-entry :global(.arrow-icon),
  .directory-contact :global(.arrow-icon),
  .network-link :global(.arrow-icon) {
    flex-shrink: 0;
  }
  .project-entry :global(.arrow-icon) {
    width: 28px;
    height: 28px;
  }
  .link-directory__networks {
    margin-top: 3.5rem;
  }
  .link-directory__networks h2 {
    margin-bottom: 1.25rem;
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .network-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2.5rem;
    padding: 0;
    list-style: none;
  }
  .network-link {
    min-height: 96px;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .network-link strong,
  .directory-contact strong {
    display: block;
    font-size: 1.125rem;
    font-weight: 650;
  }
  .network-link span > span,
  .directory-contact span > span {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.9rem;
    color: var(--leaf);
    line-height: 1.5;
  }
  .directory-contact {
    padding-block: 2rem 0;
    margin-top: 1.5rem;
  }
  .network-link:focus-visible,
  .directory-contact:focus-visible,
  .project-entry:focus-visible {
    outline: 3px solid var(--leaf);
    outline-offset: 5px;
  }
  @media (hover: hover) and (pointer: fine) {
    .project-entry:hover {
      background: var(--leaf);
    }
    .network-link:hover strong,
    .directory-contact:hover strong {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }
  }
  @media (max-width: 540px) {
    .project-entry {
      min-height: 146px;
      padding: 1.5rem;
    }
    .network-list {
      grid-template-columns: 1fr;
    }
    .network-link {
      min-height: 84px;
    }
  }
</style>
