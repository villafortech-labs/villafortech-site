---
import BaseLayout from '../layouts/BaseLayout.astro';
import profileEn from '../data/profile';
import profileEs from '../data/profile.es';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const profile = locale === 'es' ? profileEs : profileEn;
const copy = {
  en: {
    title: 'Résumé',
    description:
      'Résumé of Roberto Villafuerte, AI & Data Systems Engineer: experience, education, selected credentials, and technical skills.',
    eyebrow: 'Résumé / Updated August 2026',
    print: 'Print / save PDF',
    experience: 'Experience',
    education: 'Education',
    credentials: 'Credentials',
    languages: 'Languages',
    skills: 'Selected skills',
    skillsLabel: 'Selected technical skills',
  },
  es: {
    title: 'Currículum',
    description:
      'Currículum de Roberto Villafuerte, Ingeniero de Sistemas de IA y Datos: experiencia, formación, credenciales seleccionadas y habilidades técnicas.',
    eyebrow: 'Currículum / Actualizado en agosto de 2026',
    print: 'Imprimir / guardar PDF',
    experience: 'Experiencia',
    education: 'Formación',
    credentials: 'Credenciales',
    languages: 'Idiomas',
    skills: 'Habilidades seleccionadas',
    skillsLabel: 'Habilidades técnicas seleccionadas',
  },
}[locale];
---

<BaseLayout title={copy.title} description={copy.description} locale={locale}>
  <article class="resume-page">
    <header class="resume-header shell">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{profile.name}</h1>
        <p>{profile.headline} | {profile.location}</p>
      </div>
      <div class="resume-header__actions">
        <button
          class="button button--secondary button--md"
          type="button"
          onclick="window.print()"
        >
          {copy.print}
        </button>
        <a class="text-link" href={profile.links.email}
          >{profile.links.emailAddress}</a
        >
      </div>
    </header>

    <div class="shell resume-grid">
      <aside class="resume-summary">
        <p>{profile.introduction}</p>
        <div class="resume-contact">
          <a
            href={profile.links.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            >LinkedIn <span class="external-mark" aria-hidden="true">↗</span></a
          >
          <a
            href={profile.links.github}
            target="_blank"
            rel="noopener noreferrer"
            >GitHub <span class="external-mark" aria-hidden="true">↗</span></a
          >
        </div>
      </aside>

      <div class="resume-main">
        <section class="resume-section">
          <h2>{copy.experience}</h2>
          <div class="resume-ledger">
            {
              profile.experience.map((item, index) => (
                <article class="resume-entry">
                  <div class="resume-entry__index">
                    {String(index + 1).padStart(2, '0')}
                  </div>
                  <div>
                    <div class="resume-entry__heading">
                      <div>
                        <h3>{item.title}</h3>
                        <p>{item.organization}</p>
                      </div>
                      <time>{item.period}</time>
                    </div>
                    <ul>
                      {item.details.map((detail) => (
                        <li>{detail}</li>
                      ))}
                    </ul>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <section class="resume-section">
          <h2>{copy.education}</h2>
          <div class="resume-ledger">
            {
              profile.education.map((item, index) => (
                <article class="resume-entry resume-entry--compact">
                  <div class="resume-entry__index">
                    {String(index + 1).padStart(2, '0')}
                  </div>
                  <div>
                    <div class="resume-entry__heading">
                      <div>
                        <h3>{item.program}</h3>
                        <p>{item.institution}</p>
                      </div>
                      <time>{item.period}</time>
                    </div>
                    <p class="resume-entry__detail">{item.detail}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <div class="resume-columns">
          <section class="resume-section">
            <h2>{copy.credentials}</h2>
            <div class="compact-ledger">
              {
                profile.certifications.map((item) => (
                  <div>
                    <>
                      <span>{item.date}</span>
                      <strong>{item.name}</strong>
                      <small>{item.issuer}</small>
                    </>
                  </div>
                ))
              }
              {
                profile.honors.map((item) => (
                  <div>
                    <>
                      <span>{item.date}</span>
                      <strong>{item.name}</strong>
                      <small>{item.issuer}</small>
                    </>
                  </div>
                ))
              }
            </div>
          </section>

          <section class="resume-section">
            <h2>{copy.languages}</h2>
            <div class="compact-ledger">
              {
                profile.languages.map((item) => (
                  <div>
                    <>
                      <strong>{item.name}</strong>
                      <small>{item.level}</small>
                    </>
                  </div>
                ))
              }
            </div>
          </section>
        </div>

        <section class="resume-section resume-skills">
          <h2>{copy.skills}</h2>
          <ul aria-label={copy.skillsLabel}>
            {profile.skills.map((skill) => <li>{skill}</li>)}
          </ul>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>
