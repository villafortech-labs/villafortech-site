---
import '../styles/global.css';
import '../styles/print.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import profile from '../data/profile';
import profileEs from '../data/profile.es';
import { socialProfiles } from '../data/links';
import {
  alternateLocalePath,
  localeFromPath,
  sharedCopy,
  type Locale,
} from '../i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  noIndex?: boolean;
  type?: 'website' | 'article';
  locale?: Locale;
  alternatePath?: string;
  redirectTo?: string;
}

const {
  title,
  description,
  image = '/og-mission.png',
  noIndex = false,
  type = 'website',
  locale = localeFromPath(Astro.url.pathname),
  alternatePath,
  redirectTo,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const targetLocale: Locale = locale === 'en' ? 'es' : 'en';
const translatedPath =
  alternatePath ?? alternateLocalePath(Astro.url.pathname, targetLocale);
const translatedURL = new URL(translatedPath, Astro.site);
const englishURL = locale === 'en' ? canonicalURL : translatedURL;
const spanishURL = locale === 'es' ? canonicalURL : translatedURL;
const localeCopy = sharedCopy[locale];
const localizedProfile = locale === 'es' ? profileEs : profile;
const localizedHeadline = localizedProfile.brandLabel;
const pageTitle = title === profile.name ? title : `${title} | ${profile.name}`;
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F3EEE3" />
    <meta name="author" content={profile.name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/manrope/Manrope%5Bwght%5D.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrumentserif/InstrumentSerif-Regular.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={englishURL} />
    <link rel="alternate" hreflang="es" href={spanishURL} />
    <link rel="alternate" hreflang="x-default" href={spanishURL} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {
      redirectTo && (
        <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
      )
    }

    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.siteName} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={locale === 'es' ? 'es_EC' : 'en_US'} />
    <meta
      property="og:locale:alternate"
      content={locale === 'es' ? 'en_US' : 'es_EC'}
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${profile.name} | ${localizedHeadline}`}
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta
      name="twitter:image:alt"
      content={`${profile.name} | ${localizedHeadline}`}
    />

    <!-- JSON-LD -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            name: profile.siteName,
            url: Astro.site,
            inLanguage: ['es', 'en'],
          },
          {
            '@type': 'Person',
            name: profile.name,
            jobTitle: localizedProfile.currentRole.title,
            url: Astro.site,
            sameAs: socialProfiles.map((social) => social.url),
            homeLocation: profile.location,
          },
        ],
      })}
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{localeCopy.skipLink}</a>

    <Navbar locale={locale} alternatePath={translatedPath} />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer locale={locale} />

    <script is:inline>
      (() => {
        const reducedMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;
        const revealTargets = [...document.querySelectorAll('[data-reveal]')];

        if (reducedMotion || !('IntersectionObserver' in window)) {
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );

        revealTargets.forEach((target) => observer.observe(target));
      })();
    </script>
  </body>
</html>
