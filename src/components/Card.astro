---
import Tag from './Tag.astro';

interface Props {
  title: string;
  summary: string;
  href: string;
  tags?: string[];
  date?: string;
  variant?: 'default' | 'featured';
}

const { title, summary, href, tags = [], date, variant = 'default' } = Astro.props;

const formattedDate = date
  ? new Date(date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
    })
  : null;

const isoDate = date ? new Date(date).toISOString().split('T')[0] : null;
---

<a
  href={href}
  class:list={[
    'block p-6 bg-white border border-gray-200 rounded-lg transition-all hover:border-accent hover:shadow-sm',
    variant === 'featured' && 'border-l-4 border-l-accent',
  ]}
>
  <div class="flex items-start justify-between gap-4 mb-2">
    <h3 class="font-semibold text-gray-900 group-hover:text-accent">{title}</h3>
    {formattedDate && isoDate && (
      <time datetime={isoDate} class="text-sm text-gray-500 whitespace-nowrap">{formattedDate}</time>
    )}
  </div>

  <p class="text-gray-600 text-sm mb-4">{summary}</p>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.slice(0, 4).map((tag) => (
        <Tag size="sm">{tag}</Tag>
      ))}
    </div>
  )}
</a>
