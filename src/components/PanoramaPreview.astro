---
import type { Locale } from '../i18n';
interface Props {
  locale?: Locale;
  compact?: boolean;
}
const { locale = 'es', compact = false } = Astro.props;
const es = locale === 'es';
const copy = {
  label: es
    ? 'Vista ilustrativa con datos ficticios'
    : 'Illustrative view with fictional data',
  description: es
    ? 'Ejemplo de Panorama: un presupuesto de 800 dólares, menos 245 gastados y 95 previstos, deja 460. Un gasto de 8 dólares está pendiente de revisión y todavía no forma parte del resumen.'
    : 'Panorama example: an 800 dollar budget, minus 245 spent and 95 planned, leaves 460. An 8 dollar expense awaits review and is not yet part of the summary.',
  month: es ? 'Noviembre' : 'November',
  remaining: es ? 'Te queda del presupuesto' : 'Budget remaining',
  budget: es ? 'Presupuesto' : 'Budget',
  spent: es ? 'Gastado' : 'Spent',
  planned: es ? 'Previsto' : 'Planned',
  input: es ? '«Gasté $8 en almuerzo.»' : '“I spent $8 on lunch.”',
  review: es ? 'Por revisar' : 'Awaiting review',
  lunch: es ? 'Almuerzo' : 'Lunch',
  note: es ? 'Revisar antes de guardar' : 'Review before saving',
  pending: es
    ? 'Aún no incluido en el resumen.'
    : 'Not yet included in the summary.',
};
---

<figure
  class:list={['panorama-preview', compact && 'panorama-preview--compact']}
  data-ui
>
  <div class="panorama-preview__app" role="img" aria-label={copy.description}>
    <div class="panorama-preview__header" aria-hidden="true">
      <strong>Panorama</strong><span>{copy.month}</span>
    </div>
    <div class="panorama-preview__layout" aria-hidden="true">
      <div class="panorama-preview__summary">
        <p>{copy.remaining}</p>
        <p class="panorama-preview__balance">$460<span>.00</span></p>
        <dl>
          <div><dt>{copy.budget}</dt><dd>$800</dd></div>
          <div><dt>{copy.spent}</dt><dd>−$245</dd></div>
          <div><dt>{copy.planned}</dt><dd>−$95</dd></div>
        </dl>
      </div>
      <div class="panorama-preview__entry">
        <p class="panorama-preview__input">{copy.input}</p>
        <p class="panorama-preview__status">{copy.review}</p>
        <div class="panorama-preview__lunch">
          <span>{copy.lunch}</span><strong>$8.00</strong>
        </div>
        <p class="panorama-preview__instruction">{copy.note}</p>
        <p class="panorama-preview__pending">{copy.pending}</p>
      </div>
    </div>
  </div>
  <figcaption>{copy.label}</figcaption>
</figure>

<style>
  .panorama-preview {
    container-type: inline-size;
    width: 100%;
    padding: clamp(20px, 4vw, 48px);
    background: #dce7de;
    color: #172a25;
    font-family: var(--font-sans, Arial, sans-serif);
    margin: 0;
  }
  .panorama-preview__app {
    padding: clamp(20px, 4cqi, 34px);
    background: #fff;
    border-radius: 10px;
  }
  .panorama-preview__header,
  .panorama-preview__lunch {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .panorama-preview__header > strong {
    font-size: clamp(20px, 4.5cqi, 29px);
    font-weight: 650;
    letter-spacing: -0.035em;
  }
  .panorama-preview__header > span {
    font-size: 13px;
    color: #53665a;
  }
  .panorama-preview__layout {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 28px;
    padding-top: 32px;
  }
  .panorama-preview__summary > p:first-child {
    font-size: 14px;
    line-height: 1.5;
  }
  .panorama-preview__balance {
    margin: 10px 0 24px;
    font-size: clamp(36px, 8cqi, 56px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .panorama-preview__balance > span {
    font-size: 0.6em;
  }
  .panorama-preview dl {
    display: grid;
    gap: 9px;
    margin: 0;
  }
  .panorama-preview dl > div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    line-height: 1.4;
  }
  .panorama-preview dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .panorama-preview__entry {
    padding: 18px;
    background: #f4f6f0;
    border-radius: 6px;
  }
  .panorama-preview__input {
    font-size: clamp(16px, 3.4cqi, 21px);
    line-height: 1.4;
  }
  .panorama-preview__status {
    margin: 18px 0 9px;
    font-size: 13px;
    color: #66532e;
  }
  .panorama-preview__lunch {
    font-size: 14px;
  }
  .panorama-preview__instruction {
    margin-top: 20px;
    font-size: 14px;
    font-weight: 600;
  }
  .panorama-preview__pending {
    margin-top: 5px;
    color: #53665a;
    font-size: 13px;
    line-height: 1.5;
  }
  .panorama-preview > figcaption {
    margin-top: 16px;
    color: #43574b;
    font-size: 13px;
    line-height: 1.5;
    text-align: left;
  }
  @container (max-width: 460px) {
    .panorama-preview__layout {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-top: 26px;
    }
    .panorama-preview__balance {
      font-size: 48px;
      margin-bottom: 20px;
    }
    .panorama-preview__entry {
      padding: 18px;
    }
  }
  .panorama-preview--compact {
    padding: clamp(18px, 3vw, 36px);
  }
</style>
