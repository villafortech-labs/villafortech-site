---
import {
  alternateLocalePath,
  localeFromPath,
  localeRoutes,
  sharedCopy,
  type Locale,
} from '../i18n';

interface Props {
  locale?: Locale;
  alternatePath?: string;
}

const pathname = Astro.url.pathname;
const locale = Astro.props.locale ?? localeFromPath(pathname);
const copy = sharedCopy[locale];
const routes = localeRoutes[locale];
const targetLocale: Locale = locale === 'en' ? 'es' : 'en';
const languagePath =
  Astro.props.alternatePath ?? alternateLocalePath(pathname, targetLocale);

const navLinks = [
  { href: routes.projects, label: copy.nav.projects },
  { href: routes.about, label: copy.nav.about },
  { href: routes.contact, label: copy.nav.contact, cta: true },
];

function isActive(href: string): boolean {
  return pathname.startsWith(href);
}
---

<nav class="site-nav" aria-label={copy.navLabel}>
  <div class="shell site-nav__inner">
    <a href={routes.home} class="site-mark" aria-label={copy.homeLabel}>
      <picture>
        <source
          media="(min-width: 721px)"
          srcset="/brand/signature-horizontal.svg"
        />
        <img
          src="/brand/signature.svg"
          width="850"
          height="320"
          alt="Roberto Villafuerte"
        />
      </picture>
    </a>

    <div class="site-nav__desktop">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={['nav-link', { 'nav-link--cta': link.cta }]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={languagePath}
        class="nav-link nav-link--language"
        lang={targetLocale}
        hreflang={targetLocale}
        aria-label={copy.switchLanguage}
      >
        {targetLocale.toUpperCase()}
      </a>
    </div>

    <details class="site-nav__mobile">
      <summary>{copy.menu}</summary>
      <div class="mobile-links">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={['nav-link', { 'nav-link--cta': link.cta }]}
            >
              {link.label}
            </a>
          ))
        }
        <a
          href={languagePath}
          class="nav-link nav-link--language"
          lang={targetLocale}
          hreflang={targetLocale}
          aria-label={copy.switchLanguage}
        >
          {copy.alternateLanguageName}
        </a>
      </div>
    </details>
  </div>
</nav>
