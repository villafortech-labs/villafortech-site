---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from './ArrowIcon.astro';
import { localeRoutes, sharedCopy, type Locale } from '../i18n';
import type { Reference } from '../data/references';

interface Props {
  reference: Reference;
  locale: Locale;
}

const { reference, locale } = Astro.props;
const entry = reference.copy[locale];
const routes = localeRoutes[locale];
const shared = sharedCopy[locale];
const copy = {
  es: {
    back: 'Volver a notas y entrevistas',
    eyebrow: 'Notas / Datos y privacidad',
    date: 'Publicado',
    format: 'En esta nota',
    published: '5 de octubre de 2026',
    author: 'Autor',
    context: 'Fuentes y contexto',
    original: 'Publicación original',
    work: 'Explorar el caso técnico de SaliHub',
  },
  en: {
    back: 'Back to notes and interviews',
    eyebrow: 'Notes / Data and privacy',
    date: 'Published',
    format: 'In this note',
    published: 'October 5, 2026',
    author: 'Author',
    context: 'Sources and context',
    original: 'Original publication',
    work: 'Explore the SaliHub technical case study',
  },
}[locale];
---

<BaseLayout title={entry.seoTitle} description={entry.summary} locale={locale}>
  <article class="case-article">
    <div class="shell">
      <a class="back-link" href={`${routes.references}/`}>
        <span aria-hidden="true">←</span>
        {copy.back}
      </a>
      <header class="case-header">
        <div class="case-header__copy">
          <p class="eyebrow">{copy.eyebrow}</p>
          <h1>{entry.title}</h1>
          <p class="case-header__summary">{entry.summary}</p>
        </div>
        <dl class="case-meta">
          <div><dt>{copy.author}</dt><dd>Roberto Villafuerte</dd></div>
          <div>
            <dt>{copy.date}</dt>
            <dd><time datetime="2026-10-05">{copy.published}</time></dd>
          </div>
          <div><dt>{copy.format}</dt><dd>{entry.kind}</dd></div>
        </dl>
      </header>
      <div class="article-grid">
        <aside class="article-rail">
          <p>{entry.kind}</p>
          <p>{entry.publisher}</p>
        </aside>
        <div class="prose">
          <h2>{entry.sectionTitle}</h2>
          {entry.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <p>{entry.context}</p>
          <h2>{copy.context}</h2>
          <p class="reference-source">
            <strong>{copy.original}: </strong>
            <cite>
              <a
                href={reference.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {reference.sourceTitle}<span class="sr-only"
                  >{shared.newTab}</span
                >
              </a>
            </cite>
            <br />
            {entry.publisher} · <time datetime={reference.sourceDateTime}
              >{entry.sourceDate}</time
            >
          </p>
          <p>
            <a
              class="text-link"
              href={reference.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {entry.sourceLabel}<span aria-hidden="true"><ArrowIcon /></span>
              <span class="sr-only">{shared.newTab}</span>
            </a>
          </p>
          <p>
            <a href={`${routes.projects}/salihub-data-architecture/`}
              >{copy.work}</a
            >
          </p>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .reference-source {
    padding: 22px 26px;
    border-left: 3px solid var(--leaf);
    background: var(--sage);
    font-size: 0.9375rem;
  }
  cite {
    font-style: normal;
  }
</style>
