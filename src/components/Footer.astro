---
import profile from '../data/profile';
import { localeFromPath, localeRoutes, sharedCopy, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = sharedCopy[locale];
const routes = localeRoutes[locale];
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div>
      <a
        href={routes.home}
        class="footer-signature"
        aria-label={copy.homeLabel}
      >
        <img
          src="/brand/signature-inverse.svg"
          width="850"
          height="320"
          alt={profile.name}
          loading="lazy"
        />
      </a>
      <p class="footer-note">{copy.footerNote}</p>
    </div>

    <nav class="footer-links" aria-label={copy.footerLabel}>
      <a href={routes.projects}>{copy.footer.projects}</a>
      <a href={routes.about}>{copy.footer.about}</a>
      <a href={routes.resume}>{copy.footer.resume}</a>
      <a href={profile.links.email}>{copy.footer.email}</a>
      <a
        href={profile.links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn<span class="sr-only">{copy.newTab}</span>
      </a>
    </nav>

    <p class="footer-copyright">
      © {new Date().getFullYear()} · Roberto Villafuerte · Villa for Tech
    </p>
  </div>
</footer>
