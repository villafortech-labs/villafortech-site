---
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const copy = {
  en: {
    caption: 'Reference XGBoost audit · held-out test point estimates',
    global: 'Global 0.500',
    offline: 'Offline policy',
    tpr: 'TPR gap',
    zero: 'Closer to zero is better',
    one: 'Closer to one is better',
    ci: 'Offline-policy 95% CI',
    range: 'to',
    note: 'Each row uses its own scale. Intervals are 95% paired-bootstrap intervals for the offline policy; tracks show point-estimate direction only.',
  },
  es: {
    caption:
      'Auditoría XGBoost de referencia · estimaciones puntuales en la prueba reservada',
    global: 'Umbral global 0.500',
    offline: 'Política offline',
    tpr: 'Brecha de TPR',
    zero: 'Más cerca de cero es mejor',
    one: 'Más cerca de uno es mejor',
    ci: 'IC del 95% de la política offline',
    range: 'a',
    note: 'Cada fila usa su propia escala. Los intervalos son de bootstrap pareado al 95% para la política offline; las pistas muestran únicamente la dirección de las estimaciones puntuales.',
  },
}[locale];
---

<figure class="metric-shift" aria-labelledby="metric-shift-caption">
  <figcaption id="metric-shift-caption" class="figure-label">
    {copy.caption}
  </figcaption>

  <div class="metric-shift__legend" aria-hidden="true">
    <span><i class="metric-dot metric-dot--before"></i>{copy.global}</span>
    <span><i class="metric-dot metric-dot--after"></i>{copy.offline}</span>
  </div>

  <div class="metric-shift__rows">
    <div class="metric-row metric-row--tpr">
      <div>
        <strong>{copy.tpr}</strong><small>{copy.zero}</small>
        <small>{copy.ci} −0.0560 {copy.range} 0.0268</small>
      </div>
      <div class="metric-row__track" aria-hidden="true">
        <span class="metric-row__line"></span>
        <i class="metric-dot metric-dot--after metric-position--21"></i>
        <i class="metric-dot metric-dot--before metric-position--84"></i>
      </div>
      <div class="metric-row__values">
        <span>0.0504</span><strong>−0.0124</strong>
      </div>
    </div>

    <div class="metric-row metric-row--spd">
      <div>
        <strong>SPD</strong><small>{copy.zero}</small>
        <small>{copy.ci} 0.1468 {copy.range} 0.1670</small>
      </div>
      <div class="metric-row__track" aria-hidden="true">
        <span class="metric-row__line"></span>
        <i class="metric-dot metric-dot--after metric-position--78"></i>
        <i class="metric-dot metric-dot--before metric-position--88"></i>
      </div>
      <div class="metric-row__values">
        <span>0.1754</span><strong>0.1563</strong>
      </div>
    </div>

    <div class="metric-row metric-row--di">
      <div>
        <strong>{locale === 'es' ? 'Razón DI' : 'DI ratio'}</strong><small
          >{copy.one}</small
        >
        <small>{copy.ci} 0.3817 {copy.range} 0.4370</small>
      </div>
      <div class="metric-row__track" aria-hidden="true">
        <span class="metric-row__line"></span>
        <i class="metric-dot metric-dot--before metric-position--34"></i>
        <i class="metric-dot metric-dot--after metric-position--41"></i>
      </div>
      <div class="metric-row__values">
        <span>0.3400</span><strong>0.4120</strong>
      </div>
    </div>
  </div>

  <p class="metric-shift__note">
    {copy.note}
  </p>
</figure>
