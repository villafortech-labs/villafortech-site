---
import { pilot } from '../data/pilot';
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  locale?: 'es' | 'en';
}
const { locale = 'es' } = Astro.props;
const copy =
  locale === 'es'
    ? {
        title: 'Tu segundo cerebro con IA · 5 sesiones gratis',
        detail: '15 y 16 de octubre · Aplica hasta el martes 13',
        action: 'Completar mi aplicación',
      }
    : {
        title: 'Your second brain with AI · 5 free sessions',
        detail: 'October 15–16 · Apply by Tuesday, October 13',
        action: 'Complete my application',
      };
---

<aside class="pilot-invitation" data-pilot-closes={pilot.closesAt}>
  <a href="/segundo-cerebro/#aplicar">
    <span>
      <strong>{copy.title}</strong>
      <span class="pilot-invitation__detail">{copy.detail}</span>
    </span>
    <span class="pilot-invitation__action">
      <span>{copy.action}</span>
      <ArrowIcon direction="right" />
    </span>
  </a>
</aside>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-pilot-closes]')
    .forEach((banner) => {
      if (Date.now() >= Date.parse(banner.dataset.pilotCloses ?? ''))
        banner.hidden = true;
    });
</script>

<style>
  .pilot-invitation {
    margin: 0 0 2rem;
  }
  .pilot-invitation[hidden] {
    display: none;
  }
  .pilot-invitation a {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    color: #f4f0e5;
    background: #183c31;
    border-radius: 0.75rem;
    text-decoration: none;
  }
  .pilot-invitation strong {
    display: block;
    font-size: 1.05rem;
  }
  .pilot-invitation__detail {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.875rem;
  }
  .pilot-invitation .pilot-invitation__action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
    flex-shrink: 0;
    font-weight: 650;
  }
  .pilot-invitation__action :global(.arrow-icon) {
    flex: 0 0 20px;
  }
  .pilot-invitation a:hover {
    background: #285d48;
  }
  .pilot-invitation a:focus-visible {
    outline: 3px solid #71954d;
    outline-offset: 4px;
  }
  @media (max-width: 600px) {
    .pilot-invitation a {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
