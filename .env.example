# Server-only configuration. Never put actual secrets in this file.
# Marketplace provisions RESEND_API_KEY in connected environments.
RESEND_API_KEY=
PILOT_ADMIN_SECRET=
PILOT_REVIEW_URL=
# Existing private Blob connection uses OIDC on Vercel.
BLOB_STORE_ID=
# Public site key is embedded in the static application and review pages.
PUBLIC_TURNSTILE_SITE_KEY=
# Server-only; preserve the dedup secret across releases.
TURNSTILE_SECRET_KEY=
PILOT_DEDUP_SECRET=
# Optional migration map of HMAC claim paths to historical UUIDs; never raw emails.
PILOT_LEGACY_APPLICATION_IDS={}
